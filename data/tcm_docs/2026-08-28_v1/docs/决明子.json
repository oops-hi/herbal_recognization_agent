{
  "herb": "决明子",
  "edition": "《中国药典》2020 年版一部",
  "docs": [
    {
      "herb": "决明子",
      "section": "性味归经",
      "text": "决明子（Cassiae Semen）性味甘、苦、咸，微寒，归肝、大肠经。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "2088a40204f9c6b3d7fbcf700ae0880851b1bd8cf40566f20f923b74a64302a8"
    },
    {
      "herb": "决明子",
      "section": "功效",
      "text": "决明子（Cassiae Semen）功效：清热明目，润肠通便。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "d0e56d529eec8e23dc387232b096c45ff438330de604f68d26c45789503d30c0"
    },
    {
      "herb": "决明子",
      "section": "主治",
      "text": "决明子（Cassiae Semen）主治：目赤涩痛，羞明多泪，头痛眩晕，目暗不明，大便秘结。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "4373f36b51ae432dacfe9ebf36db2c4fcfe58717d74d46ce08fff799b5be097c"
    },
    {
      "herb": "决明子",
      "section": "用量",
      "text": "决明子（Cassiae Semen）用法用量：9～15g。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "acbe42b140116ffe2ab9c238df7188f42b3e2ac132eda843d0373f7ce84fd12b"
    },
    {
      "herb": "决明子",
      "section": "毒性",
      "text": "决明子（Cassiae Semen）毒性：无毒。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "2b8f7620a08d8a0c8092ca1d4e44aa06010102de924b33c111650ecd84a4b2d5"
    },
    {
      "herb": "决明子",
      "section": "禁忌",
      "text": "决明子（Cassiae Semen）用药禁忌：气虚便溏者不宜使用。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "c156142acc9d4237172399076b8fcdc0aa90881387aeda845b68286bd9aa0122"
    },
    {
      "herb": "决明子",
      "section": "性状",
      "text": "决明子（Cassiae Semen）性状：呈菱状方形或短圆柱形，两端平行倾斜，长 3～7mm，宽 2～4mm。表面绿棕色或暗棕色，平滑有光泽。一端较平坦，另端斜尖，背腹面各有 1 条突起的棱线，棱线两侧各有 1 条淡黄色的线形凹纹。质硬，不易破碎。种皮薄，子叶 2，黄色，呈“S”形折曲并重叠。气微，味微苦。",
      "source": "《中国药典》2020 年版一部·决明子【性状】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "da584f83fa6496a1d9404490580aad3bd5ba1f9030e1edd0f66351f8b27da2f6"
    },
    {
      "herb": "决明子",
      "section": "炮制",
      "text": "决明子（Cassiae Semen）炮制：决明子：除去杂质，洗净，干燥。炒决明子：取净决明子，照清炒法（通则 0213）炒至微鼓起、有香气。",
      "source": "《中国药典》2020 年版一部·决明子【炮制】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "11d3e926e479ebb646a37a97eb41cb7c385c0918cbf1252fff746e0a7ef2b7a3"
    },
    {
      "herb": "决明子",
      "section": "产地",
      "text": "决明子（Cassiae Semen）产地：主产于安徽、广西、四川（本品为决明 Cassia obtusifolia L. 或小决明 C. tora L. 的干燥成熟种子）",
      "source": "《中国药典》2020 年版一部·决明子【来源】（A 档）+ 教材（B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "245fbec2ac0e9315b43709006364557da0e7709576490a235082339db93d27ba"
    },
    {
      "herb": "决明子",
      "section": "鉴别要点",
      "text": "决明子（Cassiae Semen）鉴别要点：菱状方形、两端平行倾斜（“马蹄形”），表面绿棕色或暗棕色、平滑有光泽，棱线两侧有淡黄色线形凹纹，子叶“S”形折曲并重叠，味微苦。",
      "source": "《中国药典》2020 年版一部·决明子【性状】归纳 + 中药鉴定学教材（A/B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "c6eb6b0482ae5ee148539b32a1cb72048d2abef3435a20d86804b82b573ec3e5"
    }
  ]
}
