{
  "herb": "覆盆子",
  "edition": "《中国药典》2020 年版一部",
  "docs": [
    {
      "herb": "覆盆子",
      "section": "性味归经",
      "text": "覆盆子（Rubi Fructus）性味甘、酸，温，归肝、肾、膀胱经。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "d8710ecf6bf76c17d1da7b713e57957835ce6935aa8e7ad624a899f6b3da2b6e"
    },
    {
      "herb": "覆盆子",
      "section": "功效",
      "text": "覆盆子（Rubi Fructus）功效：益肾固精缩尿，养肝明目。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "1476e394639d8983883bd4d4fa47cc60b8b8837a029faaa816240df6e2279ce6"
    },
    {
      "herb": "覆盆子",
      "section": "主治",
      "text": "覆盆子（Rubi Fructus）主治：遗精滑精，遗尿尿频，阳痿早泄，目暗昏花。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "adbad96ddab5cb57c1a9dd2a197d2c36309ff7eb29d135db0010f637dcc91d5e"
    },
    {
      "herb": "覆盆子",
      "section": "用量",
      "text": "覆盆子（Rubi Fructus）用法用量：6～12g。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "f69a7f1662036ac258ddd063a428470eb2047193907b922a29f77bb25c9f49b3"
    },
    {
      "herb": "覆盆子",
      "section": "毒性",
      "text": "覆盆子（Rubi Fructus）毒性：无毒。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "34862c333b9a32afd546dbe40e2c514bb080e2aabfa0c8bd5daa5284cc090276"
    },
    {
      "herb": "覆盆子",
      "section": "禁忌",
      "text": "覆盆子（Rubi Fructus）用药禁忌：肾虚有火、小便短涩者慎用。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "43811fe0e39b71a4311f4ff0c96f0dc436e48769162e8a68cfc100a949048474"
    },
    {
      "herb": "覆盆子",
      "section": "性状",
      "text": "覆盆子（Rubi Fructus）性状：为聚合果，由多数小核果聚合而成，呈圆锥形或扁圆锥形，高 0.6～1.3cm，直径 0.5～1.2cm。表面黄绿色或淡棕色，顶端钝圆，基部中心凹入。宿萼棕褐色，下有果梗痕。小果易剥落，每个小果呈半月形，背面密被灰白色茸毛，两侧有明显的网纹，腹部有突起的棱线。体轻，质硬。气微，味微酸涩。",
      "source": "《中国药典》2020 年版一部·覆盆子【性状】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "3b0f5228dd969dc2841489c66400e2729b3af4797d681fb4713592a00edd0ab0"
    },
    {
      "herb": "覆盆子",
      "section": "炮制",
      "text": "覆盆子（Rubi Fructus）炮制：除去杂质，置沸水中略烫或略蒸，取出，干燥。",
      "source": "《中国药典》2020 年版一部·覆盆子【炮制】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "49288467fc87e065455d3a023d3e6bea14a3f56231fbe3b3772eefb0a3de2b55"
    },
    {
      "herb": "覆盆子",
      "section": "产地",
      "text": "覆盆子（Rubi Fructus）产地：主产于浙江、福建、四川（掌叶覆盆子 Rubus chingii Hu 的干燥果实）",
      "source": "《中药学》教材·覆盆子（B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "07d7d16e19b2282765b45ac6a9a04115665f854546a429cb3eb83eb0ca8d6e94"
    },
    {
      "herb": "覆盆子",
      "section": "鉴别要点",
      "text": "覆盆子（Rubi Fructus）鉴别要点：聚合果，圆锥形，表面黄绿色或淡棕色，小核果半月形、背面密被灰白色茸毛、两侧有网纹，宿萼棕褐色，味微酸涩。",
      "source": "《中国药典》2020 年版一部·覆盆子【性状】归纳（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "7c5bc641a27bdedb8014c1484a849de16ae7c5345efcfb4c29471dc5b76bce8f"
    }
  ]
}
