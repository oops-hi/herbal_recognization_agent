{
  "herb": "乌梅",
  "edition": "《中国药典》2020 年版一部",
  "docs": [
    {
      "herb": "乌梅",
      "section": "性味归经",
      "text": "乌梅（Mume Fructus）性味酸、涩，平，归肝、脾、肺、大肠经。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "a13896d03220d71d3186ecc26fa9c6c7dca3542d0868e668634c2dec247e0f8b"
    },
    {
      "herb": "乌梅",
      "section": "功效",
      "text": "乌梅（Mume Fructus）功效：敛肺，涩肠，生津，安蛔。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "f231774b3e4c537d9b331f59a94c89906dd92e34b020b4953aa1c087267dae43"
    },
    {
      "herb": "乌梅",
      "section": "主治",
      "text": "乌梅（Mume Fructus）主治：肺虚久咳，久泻久痢，虚热消渴，蛔厥呕吐腹痛。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "f158583f546677dd6a8cd504a5f3e1bacc6f4f5dbc5495ab05e8e4753ad31ab2"
    },
    {
      "herb": "乌梅",
      "section": "用量",
      "text": "乌梅（Mume Fructus）用法用量：6～12g。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "998ca5e2c75b79eb607752cea6a7e698c51fb84b2cd654a8caf5d2613e4f288f"
    },
    {
      "herb": "乌梅",
      "section": "毒性",
      "text": "乌梅（Mume Fructus）毒性：无毒。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "3dfe1a74805df269bca800f4478271e1dba642432452806a2bc80bbde09c70bd"
    },
    {
      "herb": "乌梅",
      "section": "禁忌",
      "text": "乌梅（Mume Fructus）用药禁忌：外有表邪、内有实热积滞者慎用。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "4bf1202ca47a5a755a559da7cecbf2adaf27eddfbceef722ad6042db81d0275b"
    },
    {
      "herb": "乌梅",
      "section": "性状",
      "text": "乌梅（Mume Fructus）性状：呈类球形或扁球形，直径 1.5～3cm。表面乌黑色或棕黑色，皱缩不平，基部有圆形果梗痕。果核坚硬，椭圆形，棕黄色，表面有凹点。果肉柔软，气微，味极酸。",
      "source": "《中国药典》2020 年版一部·乌梅【性状】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "956efa3295e4d1d94b9707ac7a9858cf6dca1cbdd31defd37ac7cf7da262f9db"
    },
    {
      "herb": "乌梅",
      "section": "炮制",
      "text": "乌梅（Mume Fructus）炮制：乌梅：除去杂质，洗净，干燥。乌梅炭：取净乌梅，照炒炭法（通则 0213）炒至皮肉鼓起。",
      "source": "《中国药典》2020 年版一部·乌梅【炮制】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "2af272c48c801f9bbd9ca0db6d8bf393d62aececeff1589ed0da8c5e0a6a9ad5"
    },
    {
      "herb": "乌梅",
      "section": "产地",
      "text": "乌梅（Mume Fructus）产地：主产于福建、四川、浙江、云南（梅 Prunus mume（Sieb.）Sieb. et Zucc. 的干燥近成熟果实）",
      "source": "《中药学》教材·乌梅（B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "77c76a5deefcbbdd5ae5036c6815560d581059b66637664f3bfe3b7ae57f3df3"
    },
    {
      "herb": "乌梅",
      "section": "鉴别要点",
      "text": "乌梅（Mume Fructus）鉴别要点：类球形整果，表面乌黑色或棕黑色、皱缩不平，果核坚硬、棕黄色、表面有凹点，味极酸。与山茱萸区别：山茱萸为去核的片状果肉，紫红色至紫黑色，质柔软，味酸涩微苦。",
      "source": "《中国药典》2020 年版一部·乌梅【性状】归纳 + 中药鉴定学教材（A/B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "5b531c837bc0e6bb7592d5d7b0252bec838d9f951bc2ed24c8473390b731d173"
    },
    {
      "herb": "乌梅",
      "section": "相似对比",
      "text": "乌梅（Mume Fructus）与「山茱萸」鉴别（同为酸味果实类饮片，色深皱缩，易混淆）：本品（乌梅）：类球形整果，表面乌黑色或棕黑色，皱缩不平，果核坚硬有凹点，味极酸；对比药（山茱萸）：不规则片状或囊状（去核果肉），表面紫红色至紫黑色，皱缩有光泽，质柔软，味酸涩微苦",
      "source": "中药鉴定学教材/药典对照（A/B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "f8f7f0de90ed0eeb2e24e68acd7b8537464f525e2ad950b0422039add11d0d0e"
    }
  ]
}
