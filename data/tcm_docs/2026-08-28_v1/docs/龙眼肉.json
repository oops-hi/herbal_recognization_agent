{
  "herb": "龙眼肉",
  "edition": "《中国药典》2020 年版一部",
  "docs": [
    {
      "herb": "龙眼肉",
      "section": "性味归经",
      "text": "龙眼肉（Longan Arillus）性味甘，温，归心、脾经。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "fd263ac0aef9354477e7e006eaef475b8a7f1e8b03b4a1dc06acd2686f699704"
    },
    {
      "herb": "龙眼肉",
      "section": "功效",
      "text": "龙眼肉（Longan Arillus）功效：补益心脾，养血安神。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "a24c5d181451f8bfc06b218bdc7a51211ba6b696799ca171bf8c48fd876f9431"
    },
    {
      "herb": "龙眼肉",
      "section": "主治",
      "text": "龙眼肉（Longan Arillus）主治：气血不足，心悸怔忡，健忘失眠，血虚萎黄。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "8346c2ead84b6b5475545b9cc4416c3cd83a335450d4fbbb55307f9bb2666ffe"
    },
    {
      "herb": "龙眼肉",
      "section": "用量",
      "text": "龙眼肉（Longan Arillus）用法用量：9～15g。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "5db3e86ebbd3612043b8a1f532afa5630cd09593d274aaa48994143f35696e73"
    },
    {
      "herb": "龙眼肉",
      "section": "毒性",
      "text": "龙眼肉（Longan Arillus）毒性：无毒。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "39fd6219005794740f1d5736a7e555df4200bb9f43e3b5755986e47cd4b74865"
    },
    {
      "herb": "龙眼肉",
      "section": "禁忌",
      "text": "龙眼肉（Longan Arillus）用药禁忌：湿盛中满或有停饮、痰、火者忌服。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "e05e0983d84d4c61f2a247e955e7b66737b18a0328ebb4d75642478258597606"
    },
    {
      "herb": "龙眼肉",
      "section": "性状",
      "text": "龙眼肉（Longan Arillus）性状：为纵向破裂的不规则薄片，或呈囊状，长约 1.5cm，宽 2～4cm，厚约 0.1cm。棕黄色至棕褐色，半透明，外表面皱缩不平，内表面较光亮，有细密的纵皱纹。质柔润。气微香，味甜。",
      "source": "《中国药典》2020 年版一部·龙眼肉【性状】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "1d7d4a2dcc9c0bd1e74e64a52ef815afa905e49727f9dbb386b648df2ac87d55"
    },
    {
      "herb": "龙眼肉",
      "section": "炮制",
      "text": "龙眼肉（Longan Arillus）炮制：除去杂质。",
      "source": "《中国药典》2020 年版一部·龙眼肉【炮制】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "0cb50fd9b20dcad912842f70c0c9fa3856e9222b2676a369392762f78477261d"
    },
    {
      "herb": "龙眼肉",
      "section": "产地",
      "text": "龙眼肉（Longan Arillus）产地：主产于广西（平南，道地）、福建、广东（本品为无患子科植物龙眼 Dimocarpus longan Lour. 的假种皮）",
      "source": "《中国药典》2020 年版一部·龙眼肉【来源】（A 档）+ 教材（B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "e76ba835ff2ddefc328477fc4f00cf204cee28181add67b9d81e7fb69d477cff"
    },
    {
      "herb": "龙眼肉",
      "section": "鉴别要点",
      "text": "龙眼肉（Longan Arillus）鉴别要点：纵向破裂薄片或囊状，棕黄色至棕褐色半透明，外表面皱缩不平、内表面较光亮有细密纵皱纹，质柔润，气微香，味甜。",
      "source": "《中国药典》2020 年版一部·龙眼肉【性状】归纳（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "a18faaf517d600eb053a0c6b7a86854eb36cd60a679dc1bcd85496548c870ec5"
    }
  ]
}
