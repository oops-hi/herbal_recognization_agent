{
  "herb": "当归",
  "edition": "《中国药典》2020 年版一部",
  "docs": [
    {
      "herb": "当归",
      "section": "性味归经",
      "text": "当归（Angelicae Sinensis Radix）性味甘、辛，温，归肝、心、脾经。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "a5452c4424c992a5cb6934fd03f0ee92acf65beeaf762dcaa88f60335b748836"
    },
    {
      "herb": "当归",
      "section": "功效",
      "text": "当归（Angelicae Sinensis Radix）功效：补血活血，调经止痛，润肠通便。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "a39c265256691f530883ffab7f0f9afd76df54bad28876893759967d779b3da5"
    },
    {
      "herb": "当归",
      "section": "主治",
      "text": "当归（Angelicae Sinensis Radix）主治：血虚萎黄，眩晕心悸，月经不调，经闭痛经，虚寒腹痛，风湿痹痛，跌扑损伤，痈疽疮疡，肠燥便秘；酒当归活血通经。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "67b028d7f8de68cefa5990ae90ac28eee34fe81695b52321d935029b07f24cf1"
    },
    {
      "herb": "当归",
      "section": "用量",
      "text": "当归（Angelicae Sinensis Radix）用法用量：6～12g。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "5a82aaff270df15ed7a7582bc3b39cd3af3d8f353e2131e438035dac41f7b57a"
    },
    {
      "herb": "当归",
      "section": "毒性",
      "text": "当归（Angelicae Sinensis Radix）毒性：无毒。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "c63072678f16c4fc2d71b87e98b077dcd3366556ee0d4465e2014e31d5be0c76"
    },
    {
      "herb": "当归",
      "section": "禁忌",
      "text": "当归（Angelicae Sinensis Radix）用药禁忌：湿盛中满及大便溏泄者慎用。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "f1abd9529eb269401505e7f4b65cd3562613b4254ee1031f25ff4f1767a80522"
    },
    {
      "herb": "当归",
      "section": "性状",
      "text": "当归（Angelicae Sinensis Radix）性状：呈圆形或类圆形薄片。切面黄白色或淡黄棕色，皮部厚，有裂隙及多数棕色点状分泌腔，木部色较淡，形成层环黄棕色。周边黄棕色至棕褐色，有纵皱纹。质柔韧。香气浓郁，味甘、辛、微苦。",
      "source": "《中国药典》2020 年版一部·当归【性状】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "bb077cf12c76d49c5048b6d689642adaeca1bc6dbf4c5f72f4a2269a1dcd309a"
    },
    {
      "herb": "当归",
      "section": "炮制",
      "text": "当归（Angelicae Sinensis Radix）炮制：当归：除去杂质，洗净，润透，切薄片，晒干或低温干燥。酒当归：取净当归片，照酒炙法（通则 0213）炒干。",
      "source": "《中国药典》2020 年版一部·当归【炮制】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "122d6b71d64dba6f6fc8bbf6ab0e2bd61491557653c17c00c743d10712e096dd"
    },
    {
      "herb": "当归",
      "section": "产地",
      "text": "当归（Angelicae Sinensis Radix）产地：主产于甘肃（岷县，道地“岷归”）、云南、四川（本品为伞形科植物当归 Angelica sinensis（Oliv.）Diels 的干燥根）",
      "source": "《中国药典》2020 年版一部·当归【来源】（A 档）+ 教材（B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "880ee16ccf4ce38ae9ee690e33f775de31f61cab0a6714ee52f0351c30185cd1"
    },
    {
      "herb": "当归",
      "section": "鉴别要点",
      "text": "当归（Angelicae Sinensis Radix）鉴别要点：圆形薄片，切面黄白色、皮部厚有裂隙及多数棕色点状分泌腔、形成层环黄棕色，质柔韧，香气浓郁（当归浓香为经典特征），味甘辛微苦。",
      "source": "《中国药典》2020 年版一部·当归【性状】归纳 + 中药鉴定学教材（A/B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "55836059a2b9923d5792508c068309acc5dd30007fec011f1dc9d7ad30231f7f"
    }
  ]
}
