{
  "herb": "桑椹",
  "edition": "《中国药典》2020 年版一部",
  "docs": [
    {
      "herb": "桑椹",
      "section": "性味归经",
      "text": "桑椹（Mori Fructus）性味甘、酸，寒，归心、肝、肾经。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "4d381564d62217f59c9f2a5ad3d7f3a498c7f6a08401e8449bffec33805455ea"
    },
    {
      "herb": "桑椹",
      "section": "功效",
      "text": "桑椹（Mori Fructus）功效：滋阴补血，生津润燥。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "a559800077fad9f0d6998b18494e8f758d7744fe739168c71d29cf91a997dd28"
    },
    {
      "herb": "桑椹",
      "section": "主治",
      "text": "桑椹（Mori Fructus）主治：肝肾阴虚，眩晕耳鸣，心悸失眠，须发早白，津伤口渴，内热消渴，肠燥便秘。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "66e5855d2588ec2b1e3b519852b46f109e018de58a0971e5affe044daa1d419c"
    },
    {
      "herb": "桑椹",
      "section": "用量",
      "text": "桑椹（Mori Fructus）用法用量：9～15g。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "f45223c0e404f98a62c296e4b5fbb303d4871b20163e893e901ddf9776306e4d"
    },
    {
      "herb": "桑椹",
      "section": "毒性",
      "text": "桑椹（Mori Fructus）毒性：无毒。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "f7a88551f7060dc172fa45a06f054b4d728bc9012742d4ccbfe21230eefeb6f8"
    },
    {
      "herb": "桑椹",
      "section": "禁忌",
      "text": "桑椹（Mori Fructus）用药禁忌：脾胃虚寒便溏者慎服。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "68e7f1e84f6ae175faa9473ae131dfb7e6e163c089869fdfee82aa5ee0583e3d"
    },
    {
      "herb": "桑椹",
      "section": "性状",
      "text": "桑椹（Mori Fructus）性状：为聚花果，由多数小瘦果集合而成，呈长圆形，长 1～2cm，直径 0.5～0.8cm。黄棕色、棕红色至暗紫色，有短果序梗。小瘦果卵圆形，稍扁，长约 2mm，宽约 1mm，外具肉质花被片 4 枚。气微，味微酸而甜。",
      "source": "《中国药典》2020 年版一部·桑椹【性状】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "bf45444162b2e8a005b016d73145514cfc39c6a1da823b36f3fb9f105860c1b8"
    },
    {
      "herb": "桑椹",
      "section": "炮制",
      "text": "桑椹（Mori Fructus）炮制：采收后及时干燥，或略蒸后晒干。",
      "source": "《中国药典》2020 年版一部·桑椹【炮制】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "362477b95c206fb7adb34024dcd5797b1e3dfa0dd7a8f29fcd67edefb3c757bb"
    },
    {
      "herb": "桑椹",
      "section": "产地",
      "text": "桑椹（Mori Fructus）产地：主产于四川（道地“川桑椹”）、山东、江苏、浙江（本品为桑科植物桑 Morus alba L. 的干燥果穗）",
      "source": "《中国药典》2020 年版一部·桑椹【来源】（A 档）+ 教材（B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "d614d4ec255f73f42951f9eb25406f91f67a041c81910b8a34f0fff750ee5fb2"
    },
    {
      "herb": "桑椹",
      "section": "鉴别要点",
      "text": "桑椹（Mori Fructus）鉴别要点：聚花果长圆形，黄棕色、棕红色至暗紫色，有短果序梗，小瘦果卵圆形稍扁、外具肉质花被片 4 枚，味微酸而甜。与枸杞子区别：枸杞子纺锤形、单个浆果、味甘微苦；桑椹为聚花果、小瘦果集合、味微酸而甜。",
      "source": "《中国药典》2020 年版一部·桑椹【性状】归纳 + 中药鉴定学教材（A/B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "0a495705ed519f1bd065548314d77eca5e549e7689b3261f25fac8a79c9d2095"
    },
    {
      "herb": "桑椹",
      "section": "相似对比",
      "text": "桑椹（Mori Fructus）与「枸杞子」鉴别（同为深红色小果实类饮片，色泽相近）：本品（桑椹）：聚花果长圆形，黄棕色至暗紫色，由多数小瘦果集合而成、外具肉质花被片 4 枚，味微酸而甜；对比药（枸杞子）：纺锤形或椭圆形浆果，表面鲜红色或暗红色、具不规则皱纹、顶端有小突起状花柱痕，质柔软，味甘、微苦",
      "source": "中药鉴定学教材/药典对照（A/B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "88273d54f6904f801e0e7c503663c3e8401a2633ffdb77d62ed8b845107d9dab"
    }
  ]
}
