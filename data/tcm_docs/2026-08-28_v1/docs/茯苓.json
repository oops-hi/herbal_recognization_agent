{
  "herb": "茯苓",
  "edition": "《中国药典》2020 年版一部",
  "docs": [
    {
      "herb": "茯苓",
      "section": "性味归经",
      "text": "茯苓（Poria）性味甘、淡，平，归心、肺、脾、肾经。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "d370d84cc0ba6c46a45ac78e144ddd2b5fd2263d13ba0342480bea7ae51f4aca"
    },
    {
      "herb": "茯苓",
      "section": "功效",
      "text": "茯苓（Poria）功效：利水渗湿，健脾，宁心。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "8958f9eccd0a38466d604c254b76c48e3b82f63eaf9167f9e11c6d06987f8939"
    },
    {
      "herb": "茯苓",
      "section": "主治",
      "text": "茯苓（Poria）主治：水肿尿少，痰饮眩悸，脾虚食少，便溏泄泻，心神不安，惊悸失眠。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "b981f2487bd99b1b58cd281b59e6e01e7e2ba2a8a78d8e126602e967054d982c"
    },
    {
      "herb": "茯苓",
      "section": "用量",
      "text": "茯苓（Poria）用法用量：10～15g。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "dc20ade16cf47a0463971aacc07b50efe6463df08f2ea356af48093b742044ea"
    },
    {
      "herb": "茯苓",
      "section": "毒性",
      "text": "茯苓（Poria）毒性：无毒。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "3a26a181bd383e37aaa3f87d7c380d296d461461ea279ff80269d97523b9eae0"
    },
    {
      "herb": "茯苓",
      "section": "禁忌",
      "text": "茯苓（Poria）用药禁忌：阴虚而无湿热、虚寒滑精、气虚下陷者慎服。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "f1da3b5ecdbae9902d8d3283db48582de00807d073047f907caca1891b6d2b1d"
    },
    {
      "herb": "茯苓",
      "section": "性状",
      "text": "茯苓（Poria）性状：呈类球形、椭圆形、扁圆形或不规则团块，大小不一。外皮薄而粗糙，棕褐色至黑褐色，有明显的皱缩纹理。体重，质坚实，断面颗粒性，有的具裂隙，外层淡棕色，内部白色，少数淡红色，有的中间抱有松根。气微，味淡，嚼之粘牙。",
      "source": "《中国药典》2020 年版一部·茯苓【性状】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "c19c95d312b6b922b7bae121cdd472cc3241f32f1485a027a4f9a9895d293d65"
    },
    {
      "herb": "茯苓",
      "section": "炮制",
      "text": "茯苓（Poria）炮制：茯苓：取茯苓个，浸泡，洗净，润后稍蒸，及时切取皮和块或切厚片，晒干。茯苓皮：取茯苓皮下脚料，筛去杂质。",
      "source": "《中国药典》2020 年版一部·茯苓【炮制】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "1b72d086eb0eb699f552d3a66035b7cb36f85e7892896e5ff3225460ecb4e959"
    },
    {
      "herb": "茯苓",
      "section": "产地",
      "text": "茯苓（Poria）产地：主产于云南（道地“云苓”）、安徽（大别山）、湖北、河南（本品为多孔菌科真菌茯苓 Poria cocos（Schw.）Wolf 的干燥菌核）",
      "source": "《中国药典》2020 年版一部·茯苓【来源】（A 档）+ 教材（B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "7645b21e25ce895dd6758331bd738ddef82d5e025883149654cc614a550b0895"
    },
    {
      "herb": "茯苓",
      "section": "鉴别要点",
      "text": "茯苓（Poria）鉴别要点：白色方块状，切面颗粒性、有的具裂隙，外皮棕褐色皱缩纹理明显，质坚实，味淡，嚼之粘牙。与山药区别：山药切面粉性、味微酸嚼之发黏；茯苓颗粒性、味淡嚼之粘牙。",
      "source": "《中国药典》2020 年版一部·茯苓【性状】归纳 + 中药鉴定学教材（A/B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "569dfaa4eabab6f9b3a82182ccc7c1b4ad94d88ba3a42f9897cb6008911e374c"
    },
    {
      "herb": "茯苓",
      "section": "相似对比",
      "text": "茯苓（Poria）与「山药」鉴别（同为白色系块片饮片，色近易混）：本品（茯苓）：方块状，切面白色、颗粒性、有的有裂隙，外皮棕褐色、皱缩，味淡、嚼之粘牙；对比药（山药）：类圆形厚片，切面白色、富粉性，周边偶见点状红棕色皮孔，味微酸、嚼之发黏",
      "source": "中药鉴定学教材/药典对照（A/B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "79a8d822065c5c90440b23b34de3a0455418d99a9a27478519ea431461180155"
    }
  ]
}
