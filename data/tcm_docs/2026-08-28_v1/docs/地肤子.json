{
  "herb": "地肤子",
  "edition": "《中国药典》2020 年版一部",
  "docs": [
    {
      "herb": "地肤子",
      "section": "性味归经",
      "text": "地肤子（Kochiae Fructus）性味辛、苦，寒，归肾、膀胱经。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "841c0d3857e7f89b540e9d95e8045fab482ce35120463dc77bfd8e14f53ab092"
    },
    {
      "herb": "地肤子",
      "section": "功效",
      "text": "地肤子（Kochiae Fructus）功效：清热利湿，祛风止痒。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "9ef81080a1a012051b8563bfb895a5298e93c6bd346535d2c9b8a058a818f991"
    },
    {
      "herb": "地肤子",
      "section": "主治",
      "text": "地肤子（Kochiae Fructus）主治：小便涩痛，阴痒带下，风疹，湿疹，皮肤瘙痒。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "6f7dca2772d1d6ce0e545f429009575e2706be835bcd97cf434a63bd14afda79"
    },
    {
      "herb": "地肤子",
      "section": "用量",
      "text": "地肤子（Kochiae Fructus）用法用量：9～15g。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "d580afa8a032a8df71e6e5d22edcdf2278f3cd388b52cf033d20bda5950b0f11"
    },
    {
      "herb": "地肤子",
      "section": "毒性",
      "text": "地肤子（Kochiae Fructus）毒性：无毒。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "6eec99570b7fd31ca9863bc5131cf5449b3ab9bf99fc7f08b96444327d744849"
    },
    {
      "herb": "地肤子",
      "section": "禁忌",
      "text": "地肤子（Kochiae Fructus）用药禁忌：无。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "4f87274e95fe1b5eb6939f808b3c39c3aa4b01485f2465a90b2866214545e3ac"
    },
    {
      "herb": "地肤子",
      "section": "性状",
      "text": "地肤子（Kochiae Fructus）性状：呈扁球状五角星形，直径 1～3mm。外被宿存花被，表面灰绿色或浅棕色，周围具膜质小翅 5 枚，背面中心有微突起的点状果梗痕及放射状脉纹，剥开花被，可见膜质果皮，半透明。种子扁卵形，长约 1mm，黑色。气微，味微苦。",
      "source": "《中国药典》2020 年版一部·地肤子【性状】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "26b21088e7fce7231b6308586a4066fa68aa6037dc41d66c8ac5f0b68690ad3d"
    },
    {
      "herb": "地肤子",
      "section": "炮制",
      "text": "地肤子（Kochiae Fructus）炮制：除去杂质，筛去灰屑。",
      "source": "《中国药典》2020 年版一部·地肤子【炮制】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "e3929c6a882786e2e9e1aba1f688c854e72429201ec8034aacf60f78d4f19cac"
    },
    {
      "herb": "地肤子",
      "section": "产地",
      "text": "地肤子（Kochiae Fructus）产地：主产于河北、山东、河南、山西（本品为地肤 Kochia scoparia（L.）Schrad. 的干燥成熟果实）",
      "source": "《中药学》教材·地肤子（B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "f62b5c93b010c2e33de1f002ca9f386468c9b1cd61e0fa1d6756a208076ef4ef"
    },
    {
      "herb": "地肤子",
      "section": "鉴别要点",
      "text": "地肤子（Kochiae Fructus）鉴别要点：扁球状五角星形，外被宿存花被、周围具膜质小翅 5 枚，剥开后种子扁卵形黑色，气微味微苦。",
      "source": "《中国药典》2020 年版一部·地肤子【性状】归纳（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "68e945b6a3dc8f7f4e9f74cf03889c9537d08f6a194ece4d2c35fe17fad89627"
    }
  ]
}
