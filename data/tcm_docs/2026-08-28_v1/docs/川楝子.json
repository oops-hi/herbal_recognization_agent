{
  "herb": "川楝子",
  "edition": "《中国药典》2020 年版一部",
  "docs": [
    {
      "herb": "川楝子",
      "section": "性味归经",
      "text": "川楝子（Toosendan Fructus）性味苦，寒，归肝、小肠、膀胱经。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "5d57e6d73571ecb8c2e5956269bffe3446b6ed2eebc43f0db6554718df857785"
    },
    {
      "herb": "川楝子",
      "section": "功效",
      "text": "川楝子（Toosendan Fructus）功效：疏肝泄热，行气止痛，杀虫。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "11e013706969f03852ae82581df75973602f383dfd31e73ba592279cc0a2543f"
    },
    {
      "herb": "川楝子",
      "section": "主治",
      "text": "川楝子（Toosendan Fructus）主治：肝郁化火，胸胁、脘腹胀痛，疝气疼痛，虫积腹痛。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "7b52b21dcb28fae55a28c40e9896a690532f586b0600764d5dbc03db66a9399e"
    },
    {
      "herb": "川楝子",
      "section": "用量",
      "text": "川楝子（Toosendan Fructus）用法用量：5～10g。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "1a0612f548973c61245c66aa5577e6f5fbfd5cdc39f79160abba3e06d73d8b1e"
    },
    {
      "herb": "川楝子",
      "section": "毒性",
      "text": "川楝子（Toosendan Fructus）毒性：小毒。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "cc8a7b1ea4baae4c2b00eceb1467f75f7c8b819cc8ee5b48885dde329bd8e226"
    },
    {
      "herb": "川楝子",
      "section": "禁忌",
      "text": "川楝子（Toosendan Fructus）用药禁忌：孕妇慎用；不宜过量服用。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "b4eb3b9325d3c378ca6bdcfc99198282c5bff3ba082b9b47b92c015c9e03dd7c"
    },
    {
      "herb": "川楝子",
      "section": "性状",
      "text": "川楝子（Toosendan Fructus）性状：呈类球形，直径 2～3.2cm。表面金黄色至棕黄色，微有光泽，少数凹陷或皱缩，具深棕色小点。顶端有花柱残痕，基部凹陷有果梗痕。外果皮革质，与果肉间常成空隙，果肉松软，淡黄色，遇水润湿显黏性。果核球形或卵圆形，质坚硬，两端平截，有 6～8 条纵棱，内分 6～8 室，每室含黑棕色长圆形的种子 1 粒。气特异，味酸、苦。",
      "source": "《中国药典》2020 年版一部·川楝子【性状】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "4ce2e762ce2cd439c13daafdce7591cbb1f10d35721d6f670f55e8bc02f5d759"
    },
    {
      "herb": "川楝子",
      "section": "炮制",
      "text": "川楝子（Toosendan Fructus）炮制：川楝子：除去杂质，用时捣碎。炒川楝子：取净川楝子，切厚片或碾碎，照清炒法（通则 0213）炒至表面焦黄色。",
      "source": "《中国药典》2020 年版一部·川楝子【炮制】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "11a8fd63a82ccf6b1b1194e432ecc582767979da5b7e6537cb01442c21e70ba6"
    },
    {
      "herb": "川楝子",
      "section": "产地",
      "text": "川楝子（Toosendan Fructus）产地：主产于四川（道地产区）、云南、贵州、甘肃（本品为川楝 Melia toosendan Sieb. et Zucc. 的干燥成熟果实）",
      "source": "《中药学》教材·川楝子（B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "b4bcad75cd109c3b0cd4775fe5186fc087236f97da9d79520a751b2d9b8e4a7e"
    },
    {
      "herb": "川楝子",
      "section": "鉴别要点",
      "text": "川楝子（Toosendan Fructus）鉴别要点：类球形果实，表面金黄色至棕黄色、微有光泽、具深棕色小点，果肉松软遇水显黏性，果核坚硬有 6～8 条纵棱。与桃仁/苦杏仁区别：后两者为去壳种子（扁长卵形/扁心形），无果核纵棱。",
      "source": "《中国药典》2020 年版一部·川楝子【性状】归纳 + 中药鉴定学教材（A/B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "5f03aa94994a0fe1480177c73493f0993c7e6621625e05f029f388d0fdab6351"
    },
    {
      "herb": "川楝子",
      "section": "相似对比",
      "text": "川楝子（Toosendan Fructus）与「桃仁」鉴别（外观相近，种子/果实类易混淆）：本品（川楝子）：类球形果实（连壳），金黄色至棕黄色有光泽，具深棕色小点，果核坚硬 6～8 条纵棱，味酸苦；对比药（桃仁）：扁长卵形种子，黄棕色至红棕色，密布颗粒状突起，无果核，味微苦",
      "source": "中药鉴定学教材/药典对照（A/B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "9a2e0e203a6d191ad1a400620a86f72aab126debdbe6f199d081c951508e5f42"
    },
    {
      "herb": "川楝子",
      "section": "相似对比",
      "text": "川楝子（Toosendan Fructus）与「苦杏仁」鉴别（外观相近，种子/果实类易混淆）：本品（川楝子）：类球形果实（连壳），金黄色至棕黄色，有深棕色小点，内含坚硬多棱果核；对比药（苦杏仁）：扁心形种子，黄棕色至深棕色，有深棕色脉纹，无果核，味苦",
      "source": "中药鉴定学教材/药典对照（A/B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "023d8f2129aef243f7d779106344f6d393d2c98f85aea81b4cf0b8e51fb05de4"
    }
  ]
