{
  "herb": "芡实",
  "edition": "《中国药典》2020 年版一部",
  "docs": [
    {
      "herb": "芡实",
      "section": "性味归经",
      "text": "芡实（Euryales Semen）性味甘、涩，平，归脾、肾经。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "b1f21e828cae903e7040aa4eb0bb1ef70489e8a15f770f97f5077e24b4773552"
    },
    {
      "herb": "芡实",
      "section": "功效",
      "text": "芡实（Euryales Semen）功效：益肾固精，补脾止泻，除湿止带。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "a4bf3b0ab972269e7bdf35e9cd0ddd583b3062c96f3939d94374170564eae440"
    },
    {
      "herb": "芡实",
      "section": "主治",
      "text": "芡实（Euryales Semen）主治：遗精滑精，遗尿尿频，脾虚久泻，白浊，带下。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "23b85aaf647b2364b0e517c18c6572ce6c35ba8be1cb39be9bd62256aaa88008"
    },
    {
      "herb": "芡实",
      "section": "用量",
      "text": "芡实（Euryales Semen）用法用量：9～15g。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "81a72bdc92b54b150b825ac50f2adec6737b57d44c5ebfb77082138943f23694"
    },
    {
      "herb": "芡实",
      "section": "毒性",
      "text": "芡实（Euryales Semen）毒性：无毒。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "de50c66f7e626149546ae403ef961892ab1a3e4a3af4b98bab7a53c53183662c"
    },
    {
      "herb": "芡实",
      "section": "禁忌",
      "text": "芡实（Euryales Semen）用药禁忌：无。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "78977bac148d45690eca26da3de6ccf99fd85784d5f4ba090c9a2f30e795dcd7"
    },
    {
      "herb": "芡实",
      "section": "性状",
      "text": "芡实（Euryales Semen）性状：呈类球形，多为破粒，完整者直径 5～8mm。表面有棕红色内种皮，一端黄白色，约占全体 1/3，有凹点状的种脐痕，除去内种皮显白色。质较硬，断面白色，粉性。气微，味淡。",
      "source": "《中国药典》2020 年版一部·芡实【性状】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "1bbf02c50c90cf533c0d94e93ba99ec1c97534fc6f3dc2057e90df6788ff7982"
    },
    {
      "herb": "芡实",
      "section": "炮制",
      "text": "芡实（Euryales Semen）炮制：芡实：除去杂质。麸炒芡实：取净芡实，照麸炒法（通则 0213）炒至微黄色。",
      "source": "《中国药典》2020 年版一部·芡实【炮制】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "aa16649c81c631b5b3b582c92660d833e0470493d9237401e145b656879001f4"
    },
    {
      "herb": "芡实",
      "section": "产地",
      "text": "芡实（Euryales Semen）产地：主产于江苏（苏州，道地“苏芡”）、山东、湖北（本品为睡莲科植物芡 Euryale ferox Salisb. 的干燥成熟种仁）",
      "source": "《中国药典》2020 年版一部·芡实【来源】（A 档）+ 教材（B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "461f16fb95bd852e8cf682932067d563f3ddd22939ca19806f763510b38c6942"
    },
    {
      "herb": "芡实",
      "section": "鉴别要点",
      "text": "芡实（Euryales Semen）鉴别要点：类球形，有棕红色内种皮、一端黄白色约占全体 1/3、有凹点状种脐痕，断面白色粉性，味淡。与薏苡仁区别：薏苡仁宽卵形乳白色、腹面有纵沟；与莲子区别：莲子大、有绿色莲子心。",
      "source": "《中国药典》2020 年版一部·芡实【性状】归纳 + 中药鉴定学教材（A/B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "f94ec26d4cfca98d7daee57ed92664c0284afe1fbe88ae573ae9a03711af3bdc"
    },
    {
      "herb": "芡实",
      "section": "相似对比",
      "text": "芡实（Euryales Semen）与「薏苡仁」鉴别（同为白色种仁类饮片，断面粉性，色近易混）：本品（芡实）：类球形，有棕红色内种皮、一端黄白色约占全体 1/3、有凹点状种脐痕，断面白色粉性；对比药（薏苡仁）：宽卵形或长椭圆形，表面乳白色光滑，腹面有 1 条较宽而深的纵沟",
      "source": "中药鉴定学教材/药典对照（A/B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "5feaa1023ef4352d8ed60fd26eaf108e8066a78b1f3f1d0bf068faa0104144ce"
    },
    {
      "herb": "芡实",
      "section": "相似对比",
      "text": "芡实（Euryales Semen）与「莲子」鉴别（同为水生植物种子类饮片，浅色系，易混淆）：本品（芡实）：类球形，直径 5～8mm，有棕红色内种皮、一端黄白色占 1/3，断面白色粉性，无莲子心；对比药（莲子）：椭圆形或类球形，长 1.2～1.8cm，一端中心乳头状突起深棕色，子叶黄白色肥厚、中含绿色莲子心",
      "source": "中药鉴定学教材/药典对照（A/B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "99bc856341dad4208e005555d22d6d29886876a04840443f8261757755d1d090"
    }
  ]
}
