  "docs": [
    {
      "herb": "淡豆豉",
      "section": "性味归经",
      "text": "淡豆豉（Sojae Semen Praeparatum）性味苦、辛，凉，归肺、胃经。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "69ad40d884f67888c3d505a9cb966828d765989c4c2d208446fa7896db79d387"
    },
    {
      "herb": "淡豆豉",
      "section": "功效",
      "text": "淡豆豉（Sojae Semen Praeparatum）功效：解表，除烦，宣发郁热。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "093825d9affc1495436265e141898a1b5dc5f7e51daecbc663b1eed65d412400"
    },
    {
      "herb": "淡豆豉",
      "section": "主治",
      "text": "淡豆豉（Sojae Semen Praeparatum）主治：感冒，寒热头痛，烦躁胸闷，虚烦不眠。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "2ec60317ffef3a70dbcee0db17b8a807ca51d3549426d2cecac69819c9663564"
    },
    {
      "herb": "淡豆豉",
      "section": "用量",
      "text": "淡豆豉（Sojae Semen Praeparatum）用法用量：6～12g。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "0f3eb0037819f9b5b2123cb4a3a846f9be84fae946c3b7400e0d8d90bfa6696a"
    },
    {
      "herb": "淡豆豉",
      "section": "毒性",
      "text": "淡豆豉（Sojae Semen Praeparatum）毒性：无毒。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "c1a4294665e83c29737fc6dfb5392fe33ff72518f41db3ca9f9168021522a66f"
    },
    {
      "herb": "淡豆豉",
      "section": "禁忌",
      "text": "淡豆豉（Sojae Semen Praeparatum）用药禁忌：无。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "a82273d177ff61dc4e8945025bc68bdc480411c7b2df744c293ab427816e1a7f"
    },
    {
      "herb": "淡豆豉",
      "section": "性状",
      "text": "淡豆豉（Sojae Semen Praeparatum）性状：呈椭圆形，略扁，长 0.6～1cm，直径 0.5～0.7cm。表面黑色，皱缩不平，一侧有长椭圆形种脐。质柔软，断面棕黑色。气香，味微甘。",
      "source": "《中国药典》2020 年版一部·淡豆豉【性状】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "78dfcba6cf049f8e566f4c2cc2588fae65bf54fa7a5f65045ee03a59f4c85f4d"
    },
    {
      "herb": "淡豆豉",
      "section": "炮制",
      "text": "淡豆豉（Sojae Semen Praeparatum）炮制：取桑叶、青蒿各 70～100g，加水煎煮，滤过，煎液拌入净大豆 1000g 中，俟吸尽后，蒸透，取出，稍晾，再置容器内，用煎过的桑叶、青蒿渣覆盖，闷使发酵至黄衣上遍时，取出，除去药渣，洗净，置容器内再闷 15～20 天，至充分发酵、香气溢出时，取出，略蒸，干燥，即得。",
      "source": "《中国药典》2020 年版一部·淡豆豉【炮制】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "2b0a86bff8f3a32e304532fed3dc7c9910987e872d9441e22cc64d254fa96be5"
    },
    {
      "herb": "淡豆豉",
      "section": "产地",
      "text": "淡豆豉（Sojae Semen Praeparatum）产地：主产于广东、江苏、四川（本品为豆科植物大豆 Glycine max（L.）Merr. 的成熟种子的发酵加工品）",
      "source": "《中国药典》2020 年版一部·淡豆豉【来源】（A 档）+ 教材（B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "465b908fc57a600089f8c2a69640ee139233a11246b07eeb3f8ce40c16b45f39"
    },
    {
      "herb": "淡豆豉",
      "section": "鉴别要点",
      "text": "淡豆豉（Sojae Semen Praeparatum）鉴别要点：椭圆形略扁，表面黑色、皱缩不平，一侧有长椭圆形种脐，质柔软、断面棕黑色，气香，味微甘（发酵品，与生黑豆区别：生黑豆种脐明显、断面浅黄、无发酵香气）。",
      "source": "《中国药典》2020 年版一部·淡豆豉【性状】归纳（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "48ea0d8ab7ab0f746194cbd0fe7d14dbe906b0a5549680a9531b8c0eee050f01"
    }
  ]
}
