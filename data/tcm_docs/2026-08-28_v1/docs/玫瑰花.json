{
  "herb": "玫瑰花",
  "edition": "《中国药典》2020 年版一部",
  "docs": [
    {
      "herb": "玫瑰花",
      "section": "性味归经",
      "text": "玫瑰花（Rosae Rugosae Flos）性味甘、微苦，温，归肝、脾经。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "a056f6f10fbbc4c03d8a8a7b9e3c6544f738293cb5fc252e108ec20cca518f29"
    },
    {
      "herb": "玫瑰花",
      "section": "功效",
      "text": "玫瑰花（Rosae Rugosae Flos）功效：行气解郁，和血，止痛。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "f45216789a800077d72dd98a73d0a499a35f96bf04fa1c7ae0d8d8bce25c6d0f"
    },
    {
      "herb": "玫瑰花",
      "section": "主治",
      "text": "玫瑰花（Rosae Rugosae Flos）主治：肝胃气痛，食少呕恶，月经不调，跌扑伤痛。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "50aa386fb043a4741132a878edbedd5a63b183c96d73c95fdb4c1388e37f625a"
    },
    {
      "herb": "玫瑰花",
      "section": "用量",
      "text": "玫瑰花（Rosae Rugosae Flos）用法用量：3～6g。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "62f949c5d9a6d7797a60a6a8ed403e9a6d9e601c0c8e5b4bc6c186fad78c1c61"
    },
    {
      "herb": "玫瑰花",
      "section": "毒性",
      "text": "玫瑰花（Rosae Rugosae Flos）毒性：无毒。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "8745b0054ae84e591e9a5b26aec2959a26e9d54100b9b0ae931e734dd5782b03"
    },
    {
      "herb": "玫瑰花",
      "section": "禁忌",
      "text": "玫瑰花（Rosae Rugosae Flos）用药禁忌：无。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "682a4dc7eda7affc16afbb788cea2744b4c32f9dc19651fcfd52a147acf0a58c"
    },
    {
      "herb": "玫瑰花",
      "section": "性状",
      "text": "玫瑰花（Rosae Rugosae Flos）性状：略呈半球形或不规则团状，直径 0.7～1.5cm。残留花梗上被细柔毛，花托半球形，与花萼基部合生；萼片 5，披针形，黄绿色或棕绿色，被有细柔毛；花瓣多皱缩，展平后宽卵形，呈覆瓦状排列，紫红色，有的黄棕色；雄蕊多数，黄褐色；花柱多数，柱头在花托口处平展，深紫红色。体轻，质脆。气芳香浓郁，味微苦涩。",
      "source": "《中国药典》2020 年版一部·玫瑰花【性状】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "139687289b4bf89bca32b59f0876fe085a7bf384d80ba965c3a72d141a165e88"
    },
    {
      "herb": "玫瑰花",
      "section": "炮制",
      "text": "玫瑰花（Rosae Rugosae Flos）炮制：除去杂质，摘去花柄及蒂。",
      "source": "《中国药典》2020 年版一部·玫瑰花【炮制】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "45379c898b94a8f68e416a9a31095bef3f150ec1222646411ca4b6a6b80334a1"
    },
    {
      "herb": "玫瑰花",
      "section": "产地",
      "text": "玫瑰花（Rosae Rugosae Flos）产地：主产于甘肃（永登，道地“苦水玫瑰”）、山东（平阴，道地“平阴玫瑰”）、云南（本品为蔷薇科植物玫瑰 Rosa rugosa Thunb. 的干燥花蕾）",
      "source": "《中国药典》2020 年版一部·玫瑰花【来源】（A 档）+ 教材（B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "199adc0e182ca4a618348162785ece516f96901d143bcaf3c905f935b5607178"
    },
    {
      "herb": "玫瑰花",
      "section": "鉴别要点",
      "text": "玫瑰花（Rosae Rugosae Flos）鉴别要点：半球形或不规则团状花蕾，萼片 5 披针形黄绿色被细柔毛，花瓣紫红色覆瓦状排列，气芳香浓郁，味微苦涩。与月季花区别：月季花花托长圆形、萼片反卷、香气较淡。",
      "source": "《中国药典》2020 年版一部·玫瑰花【性状】归纳 + 中药鉴定学教材（A/B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "f2c329059242878f8802702a8cdf02e51ac0408e16ca4653e4fb58883888bebd"
    }
  ]
}
