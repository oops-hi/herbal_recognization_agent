{
  "herb": "木瓜",
  "edition": "《中国药典》2020 年版一部",
  "docs": [
    {
      "herb": "木瓜",
      "section": "性味归经",
      "text": "木瓜（Chaenomelis Fructus）性味酸，温，归肝、脾经。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "0c398eb7b31a2df3e1ab3787ba430ef12979857c175f93bfbef053decd6f74d4"
    },
    {
      "herb": "木瓜",
      "section": "功效",
      "text": "木瓜（Chaenomelis Fructus）功效：舒筋活络，和胃化湿。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "e2ee35785937881e3e97cdfa8dd78fba211cb238fc617af38e25bb26a1aac16a"
    },
    {
      "herb": "木瓜",
      "section": "主治",
      "text": "木瓜（Chaenomelis Fructus）主治：湿痹拘挛，腰膝关节酸重疼痛，暑湿吐泻，转筋挛痛，脚气水肿。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "66f8e082fbfb4611501d1efb1b2aafa24fe439242f35ec8e5cdad0f11f0c8e4f"
    },
    {
      "herb": "木瓜",
      "section": "用量",
      "text": "木瓜（Chaenomelis Fructus）用法用量：6～9g。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "79a18bfc58e49bf842def904d48f1a583f6ab531619eda48527050f07cdd85d2"
    },
    {
      "herb": "木瓜",
      "section": "毒性",
      "text": "木瓜（Chaenomelis Fructus）毒性：无毒。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "79a088c73b2890687699456addbb28ccb837fc45091d7c5c3e46aa0bbfc6aac9"
    },
    {
      "herb": "木瓜",
      "section": "禁忌",
      "text": "木瓜（Chaenomelis Fructus）用药禁忌：胃酸过多者不宜服用。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "dbb637b08aff50fc2288a8d21457338783760a2f6d7b4e8446534f1ca8606e0e"
    },
    {
      "herb": "木瓜",
      "section": "性状",
      "text": "木瓜（Chaenomelis Fructus）性状：呈长圆形，多纵剖成两半，长 4～9cm，宽 2～5cm，厚 1～2.5cm。外表面紫红色或红棕色，有不规则的深皱纹；剖面边缘向内卷曲，果肉红棕色，中心部分凹陷，棕黄色。种子扁长三角形，多脱落。质坚硬。气微清香，味酸。",
      "source": "《中国药典》2020 年版一部·木瓜【性状】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "145a76cdd66d56f9f11800516b77945ba9066ef2b5d05f85e718b62f127f0ebc"
    },
    {
      "herb": "木瓜",
      "section": "炮制",
      "text": "木瓜（Chaenomelis Fructus）炮制：洗净，润透或蒸透后切薄片，晒干。",
      "source": "《中国药典》2020 年版一部·木瓜【炮制】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "bdead1564c47b8cabfa01186d2f00c36d29552ecfab8381d0788c010a8dedd05"
    },
    {
      "herb": "木瓜",
      "section": "产地",
      "text": "木瓜（Chaenomelis Fructus）产地：主产于安徽（宣城，道地“宣木瓜”）、湖北、浙江、四川（本品为贴梗海棠 Chaenomeles speciosa（Sweet）Nakai 的干燥近成熟果实）",
      "source": "《中药学》教材·木瓜（B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "15b3f16a37f840f06e67c986f240ba7af46d4f9518381466e8cdc42b5869563c"
    },
    {
      "herb": "木瓜",
      "section": "鉴别要点",
      "text": "木瓜（Chaenomelis Fructus）鉴别要点：长圆形纵剖瓣，外表面紫红色或红棕色、具不规则深皱纹，剖面边缘内卷，果肉红棕色，味酸。与山楂区别：山楂为圆形片、外皮红色、横切面有 5 粒果核；木瓜体大、纵剖、无 5 粒果核结构。",
      "source": "《中国药典》2020 年版一部·木瓜【性状】归纳 + 中药鉴定学教材（A/B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "e0704d5e39bad192bdbbe017ac5e46fb14fa3ca61974693dac3ed50714a0fed2"
    },
    {
      "herb": "木瓜",
      "section": "相似对比",
      "text": "木瓜（Chaenomelis Fructus）与「山楂」鉴别（同为红色果实类饮片，色泽相近）：本品（木瓜）：长圆形纵剖瓣，外表面紫红色、具不规则深皱纹，剖面边缘向内卷曲，果肉红棕色，味酸；对比药（山楂）：圆形果片，外皮红色、具皱纹与灰白小斑点，横切面可见 5 粒果核，味酸微甜",
      "source": "中药鉴定学教材/药典对照（A/B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "aa164bad2ff03650c2ce01dc979e267abe39813f46d095b27a27b6a384b7f5f8"
    }
  ]
}
