{
  "herb": "荷叶",
  "edition": "《中国药典》2020 年版一部",
  "docs": [
    {
      "herb": "荷叶",
      "section": "性味归经",
      "text": "荷叶（Nelumbinis Folium）性味苦，平，归肝、脾、胃经。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "6ef34dcdc29505fee3ddc6bc96006b3fb27b593002be8ac95df3056a196a94ea"
    },
    {
      "herb": "荷叶",
      "section": "功效",
      "text": "荷叶（Nelumbinis Folium）功效：清暑化湿，升发清阳，凉血止血。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "7c9982ecb7d7bdabdba248ca4e96a5fa20fe628f4e6b00d29f53467d7c0ae5c8"
    },
    {
      "herb": "荷叶",
      "section": "主治",
      "text": "荷叶（Nelumbinis Folium）主治：暑热烦渴，暑湿泄泻，脾虚泄泻，血热吐衄，便血崩漏。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "93a6defffd60dd2603ad6d54c065ca5691dfe03ded60c33c27785ab49c06c798"
    },
    {
      "herb": "荷叶",
      "section": "用量",
      "text": "荷叶（Nelumbinis Folium）用法用量：3～10g。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "11bb5cb35e2af9118b5f13f7a5ba262b0fed6b7450d2bcfc64c4cab1bb3d3b17"
    },
    {
      "herb": "荷叶",
      "section": "毒性",
      "text": "荷叶（Nelumbinis Folium）毒性：无毒。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "4e3fcf1cc607483eb1d7108e2e4e63607e95d08f6467c1429628c9895994364c"
    },
    {
      "herb": "荷叶",
      "section": "禁忌",
      "text": "荷叶（Nelumbinis Folium）用药禁忌：无。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "8ba1915cb491fff3b1614f90b05123da10cf5ed5a318b6ff845af9dc2f2552af"
    },
    {
      "herb": "荷叶",
      "section": "性状",
      "text": "荷叶（Nelumbinis Folium）性状：呈不规则的丝状或片状。叶片卷折，上表面深绿色或黄绿色，较光滑；下表面灰绿色，较粗糙，有细密的脉纹。质脆，易破碎。气清香，味微涩。",
      "source": "《中国药典》2020 年版一部·荷叶【性状】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "c653c002c1a181afee8025ec34594c86c6f8bda4f65d7833a70fb6f9679218cc"
    },
    {
      "herb": "荷叶",
      "section": "炮制",
      "text": "荷叶（Nelumbinis Folium）炮制：荷叶：喷淋水，润透，切丝，干燥。荷叶炭：取净荷叶，照煅炭法（通则 0213）煅成炭。",
      "source": "《中国药典》2020 年版一部·荷叶【炮制】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "83e02fad23930ac0030d1104f81b890cbaf0f4f0f802ea547ea4557c0119c732"
    },
    {
      "herb": "荷叶",
      "section": "产地",
      "text": "荷叶（Nelumbinis Folium）产地：主产于湖南、湖北、江苏、浙江（本品为睡莲科植物莲 Nelumbo nucifera Gaertn. 的干燥叶）",
      "source": "《中国药典》2020 年版一部·荷叶【来源】（A 档）+ 教材（B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "67af5469b59f5241c8f5ba83d5a2d9014500359f5a70a82f00d968f654ea76e3"
    },
    {
      "herb": "荷叶",
      "section": "鉴别要点",
      "text": "荷叶（Nelumbinis Folium）鉴别要点：丝状或片状，上表面深绿色或黄绿色较光滑，下表面灰绿色较粗糙、有细密脉纹，质脆易碎，气清香，味微涩。",
      "source": "《中国药典》2020 年版一部·荷叶【性状】归纳（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "701727ab61c5cd57673f87a1cec84e5f3b400f340396ce521bd5452163410ae2"
    }
  ]
}
