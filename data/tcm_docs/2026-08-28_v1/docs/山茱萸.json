{
  "herb": "山茱萸",
  "edition": "《中国药典》2020 年版一部",
  "docs": [
    {
      "herb": "山茱萸",
      "section": "性味归经",
      "text": "山茱萸（Corni Fructus）性味酸、涩，微温，归肝、肾经。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "4b9688af55d47cb1b580473022e62eed7aacf2bfbb667490d4b3e08df496948d"
    },
    {
      "herb": "山茱萸",
      "section": "功效",
      "text": "山茱萸（Corni Fructus）功效：补益肝肾，收涩固脱。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "83a83e92905d2bf5ac1ae98d7bcd2d11b2a16a3deae5f6a1329dd7af2e42c330"
    },
    {
      "herb": "山茱萸",
      "section": "主治",
      "text": "山茱萸（Corni Fructus）主治：眩晕耳鸣，腰膝酸痛，阳痿遗精，遗尿尿频，崩漏带下，大汗虚脱，内热消渴。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "5bf702a621024dc3a4820b2f4763f3812157a9078bd1942a94d28391d0971d1f"
    },
    {
      "herb": "山茱萸",
      "section": "用量",
      "text": "山茱萸（Corni Fructus）用法用量：6～12g。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "fc55d85e4c463440096273fed51c0e84481852c0b8d8508aac7c190c99402af7"
    },
    {
      "herb": "山茱萸",
      "section": "毒性",
      "text": "山茱萸（Corni Fructus）毒性：无毒。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "fef60ebe2da0a03fa90f72c9ff4c94ce33e3c8806198a3c6ae3527536bc5208b"
    },
    {
      "herb": "山茱萸",
      "section": "禁忌",
      "text": "山茱萸（Corni Fructus）用药禁忌：命门火炽、素有湿热、小便淋涩者慎用。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "2777392c497990f4be11f4d3bc4d6b28b38c70d5a8440891638f1e1c1fee82f9"
    },
    {
      "herb": "山茱萸",
      "section": "性状",
      "text": "山茱萸（Corni Fructus）性状：呈不规则的片状或囊状，长 1～1.5cm，宽 0.5～1cm。表面紫红色至紫黑色，皱缩，有光泽。顶端有的有圆形宿萼痕，基部有果梗痕。质柔软。气微，味酸、涩、微苦。",
      "source": "《中国药典》2020 年版一部·山茱萸【性状】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "eca725cda78331ad99d025d23b4ff80baee2a4635c3041df7bf394c12c1863e2"
    },
    {
      "herb": "山茱萸",
      "section": "炮制",
      "text": "山茱萸（Corni Fructus）炮制：山萸肉：除去杂质和残留果核。酒萸肉：取净山萸肉，照酒炖法或酒蒸法（通则 0213）炖或蒸至酒吸尽，取出，干燥。",
      "source": "《中国药典》2020 年版一部·山茱萸【炮制】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "7311054e82e77b4d5fbca6247fc87047bccef87e84f6f67cc78c1f3249f033de"
    },
    {
      "herb": "山茱萸",
      "section": "产地",
      "text": "山茱萸（Corni Fructus）产地：主产于浙江、河南、陕西、安徽（山茱萸 Cornus officinalis Sieb. et Zucc. 的干燥成熟果肉）",
      "source": "《中药学》教材·山茱萸（B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "40ab04ad15f3897c1a483dc6f669fa80343d837254bcda04260044059b6fd2c2"
    },
    {
      "herb": "山茱萸",
      "section": "鉴别要点",
      "text": "山茱萸（Corni Fructus）鉴别要点：不规则片状或囊状，表面紫红色至紫黑色、皱缩有光泽，质柔软，味酸涩微苦。与乌梅区别：乌梅为类球形整果，乌黑色，果核坚硬有凹点，味极酸。",
      "source": "《中国药典》2020 年版一部·山茱萸【性状】归纳 + 中药鉴定学教材（A/B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "c9048664ce6377ce3b8a46b98bb267906f79c1507b0a26010a69b11a590e68a4"
    },
    {
      "herb": "山茱萸",
      "section": "相似对比",
      "text": "山茱萸（Corni Fructus）与「乌梅」鉴别（同为酸味果实类饮片，色深皱缩，易混淆）：本品（山茱萸）：不规则片状或囊状（去核果肉），表面紫红色至紫黑色，皱缩有光泽，质柔软，味酸涩微苦；对比药（乌梅）：类球形整果，表面乌黑色或棕黑色，果核坚硬椭圆形、表面有凹点，果肉紧贴核，味极酸",
      "source": "中药鉴定学教材/药典对照（A/B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "b84bf3dd0b65f98329bb08f7a46fc35fba53efc9953b3960dfb7d233dd558704"
    }
  ]
}
