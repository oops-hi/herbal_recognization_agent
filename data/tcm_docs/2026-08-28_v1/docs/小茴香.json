{
  "herb": "小茴香",
  "edition": "《中国药典》2020 年版一部",
  "docs": [
    {
      "herb": "小茴香",
      "section": "性味归经",
      "text": "小茴香（Foeniculi Fructus）性味辛，温，归肝、肾、脾、胃经。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "8fabca052952d4a962246bc9dcf7acf928ebc7a26bd2047f52eb546776831ccd"
    },
    {
      "herb": "小茴香",
      "section": "功效",
      "text": "小茴香（Foeniculi Fructus）功效：散寒止痛，理气和胃。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "7c3b66685391e04e22824f3fb31e44a09d53d5c557ccc1ed4309b18d9b0547df"
    },
    {
      "herb": "小茴香",
      "section": "主治",
      "text": "小茴香（Foeniculi Fructus）主治：寒疝腹痛，睾丸偏坠，痛经，少腹冷痛，脘腹胀痛，食少吐泻。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "f5fb1f801232fb701888a322e944e4e637ec5ebd876b1f10dfcb28aa01d3f6d0"
    },
    {
      "herb": "小茴香",
      "section": "用量",
      "text": "小茴香（Foeniculi Fructus）用法用量：3～6g。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "0f75317f37906d3feeaf422be5ea16e0b11c4fad0024586c11818afd79abe96b"
    },
    {
      "herb": "小茴香",
      "section": "毒性",
      "text": "小茴香（Foeniculi Fructus）毒性：无毒。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "2fb4d20968a86ad1b18e5ea03b409ee20cf0ce3180e253a8730b5fc65ae4c651"
    },
    {
      "herb": "小茴香",
      "section": "禁忌",
      "text": "小茴香（Foeniculi Fructus）用药禁忌：阴虚火旺者慎用。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "926928fb0cf2cde2ea243c23bd0fcbc7b8a2847c61804f83c30f8c038ca31054"
    },
    {
      "herb": "小茴香",
      "section": "性状",
      "text": "小茴香（Foeniculi Fructus）性状：为双悬果，呈圆柱形，有的稍弯曲，长 4～8mm，直径 1.5～2.5mm。表面黄绿色或淡黄色，两端略尖，顶端残留有黄棕色突起的柱基，基部有时有细小的果梗。分果呈长椭圆形，背面有纵棱 5 条，接合面平坦而较宽。横切面略呈五边形，背面的四边约等长。有特异香气，味微甜、辛。",
      "source": "《中国药典》2020 年版一部·小茴香【性状】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "aa55584762d9b8c6a8c862d0cc6d4626a2e61a37130e63eedb649c8bda3a0f98"
    },
    {
      "herb": "小茴香",
      "section": "炮制",
      "text": "小茴香（Foeniculi Fructus）炮制：小茴香：除去杂质。盐小茴香：取净小茴香，照盐水炙法（通则 0213）炒至微黄色。",
      "source": "《中国药典》2020 年版一部·小茴香【炮制】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "ea7da2bc93b9da5f296ef3f983c0c67e68c9fa5b5cf6ec1fddcaacd7c8351753"
    },
    {
      "herb": "小茴香",
      "section": "产地",
      "text": "小茴香（Foeniculi Fructus）产地：主产于内蒙古、山西、甘肃（本品为茴香 Foeniculum vulgare Mill. 的干燥成熟果实）",
      "source": "《中药学》教材·小茴香（B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "282414c45f24cf39e07a4b599976c2995a1503106b3a8f3d6f4d74ecbbaa49de"
    },
    {
      "herb": "小茴香",
      "section": "鉴别要点",
      "text": "小茴香（Foeniculi Fructus）鉴别要点：双悬果，圆柱形，黄绿色或淡黄色，分果背面有纵棱 5 条，横切面略呈五边形，有特异香气，味微甜辛。",
      "source": "《中国药典》2020 年版一部·小茴香【性状】归纳（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "6daedacdf178a1dcd69bc5c7bb68880da8470fd4d3f640255282e44c3ec7326f"
    }
  ]
}
