{
  "herb": "金樱子",
  "edition": "《中国药典》2020 年版一部",
  "docs": [
    {
      "herb": "金樱子",
      "section": "性味归经",
      "text": "金樱子（Rosae Laevigatae Fructus）性味酸、甘、涩，平，归肾、膀胱、大肠经。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "5c8aad8219cf74508ef5ea10d77774b81778d4dda4d2ba72c9256232123dd95a"
    },
    {
      "herb": "金樱子",
      "section": "功效",
      "text": "金樱子（Rosae Laevigatae Fructus）功效：固精缩尿，固崩止带，涩肠止泻。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "a6e575642bb3d4b257f2da03e102cf0a646bdcf321091068fc1cf4c17f8cce89"
    },
    {
      "herb": "金樱子",
      "section": "主治",
      "text": "金樱子（Rosae Laevigatae Fructus）主治：遗精滑精，遗尿尿频，崩漏带下，久泻久痢。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "35f5d4fa77a702a8315dae04a756f775a2a21063a314c98be67ffc033bd0578e"
    },
    {
      "herb": "金樱子",
      "section": "用量",
      "text": "金樱子（Rosae Laevigatae Fructus）用法用量：6～12g。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "fbdd9f98d2720e0e3a5f401eb3f00b6b3bbd9c859c64241c6bf27fccc1eea22a"
    },
    {
      "herb": "金樱子",
      "section": "毒性",
      "text": "金樱子（Rosae Laevigatae Fructus）毒性：无毒。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "2978365b7faa98c95ae416eba73360f121df9fe55545f91a263c5c32bfb9b620"
    },
    {
      "herb": "金樱子",
      "section": "禁忌",
      "text": "金樱子（Rosae Laevigatae Fructus）用药禁忌：有实火、邪热者慎用。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "8e1d5fa9c039cb8016a44c844fa9d701046335f42e954d11d30a2e77ad98f1c5"
    },
    {
      "herb": "金樱子",
      "section": "性状",
      "text": "金樱子（Rosae Laevigatae Fructus）性状：呈倒卵形纵剖瓣，长 2～3.5cm，直径 1～1.8cm。表面红黄色或红棕色，有突起的棕色小点（刺的残基）。顶端有花萼残基，下部渐尖。内壁淡红棕色，有黄色绒毛。质硬。气微，味甘、微涩。",
      "source": "《中国药典》2020 年版一部·金樱子【性状】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "e594ca68ba63829697e358585fabaccae7f14454465dab547a904c57b792d82b"
    },
    {
      "herb": "金樱子",
      "section": "炮制",
      "text": "金樱子（Rosae Laevigatae Fructus）炮制：除去杂质，洗净，干燥。",
      "source": "《中国药典》2020 年版一部·金樱子【炮制】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "5478d9752c36ba58872bac502c5c1241b2e0ab50cfca33ad0ef01a8becb11101"
    },
    {
      "herb": "金樱子",
      "section": "产地",
      "text": "金樱子（Rosae Laevigatae Fructus）产地：主产于广东、广西、湖南、江西、四川（本品为金樱子 Rosa laevigata Michx. 的干燥成熟果实）",
      "source": "《中药学》教材·金樱子（B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "93bd305125b680e047369c34d3ddb24dd9a8b9d13408d38c7aa06a905569c0ce"
    },
    {
      "herb": "金樱子",
      "section": "鉴别要点",
      "text": "金樱子（Rosae Laevigatae Fructus）鉴别要点：倒卵形纵剖瓣，表面红黄色或红棕色，密布突起棕色小点（刺残基），内壁有黄色绒毛，质硬，味甘微涩。与山楂区别：山楂为近球形果片或果饼，表面深红色，无刺残基，种子 5 粒、光滑。",
      "source": "《中国药典》2020 年版一部·金樱子【性状】归纳 + 中药鉴定学教材（A/B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "234565f6f67a5536f61427b6cc559264b469e727cbadff15e005d87722f8368d"
    },
    {
      "herb": "金樱子",
      "section": "相似对比",
      "text": "金樱子（Rosae Laevigatae Fructus）与「山楂」鉴别（同为果实类饮片，红棕色系，易混淆）：本品（金樱子）：倒卵形纵剖瓣，表面有突起棕色小点（刺残基），内壁有黄色绒毛，味甘微涩；对比药（山楂）：近球形果片，表面深红色，具细皱纹，无刺残基，种子 5 粒、灰棕色光滑，味酸微甜",
      "source": "中药鉴定学教材/药典对照（A/B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "be2833e0a1b3f77b57c2eda0c5d73e8bf8798a42eea23f74f74d5371fcd00c21"
    }
  ]
}
