{
  "herb": "泽泻",
  "edition": "《中国药典》2020 年版一部",
  "docs": [
    {
      "herb": "泽泻",
      "section": "性味归经",
      "text": "泽泻（Alismatis Rhizoma）性味甘、淡，寒，归肾、膀胱经。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "56b17330057f5ddf94ab6e4978a3a2916a9fc19d31f869e928262160842f2d4f"
    },
    {
      "herb": "泽泻",
      "section": "功效",
      "text": "泽泻（Alismatis Rhizoma）功效：利水渗湿，泄热，化浊降脂。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "cffc7ab87a08380577313e779a8c0f4ec26b7ec919a5174462a0013248f8c8ed"
    },
    {
      "herb": "泽泻",
      "section": "主治",
      "text": "泽泻（Alismatis Rhizoma）主治：小便不利，水肿胀满，泄泻尿少，痰饮眩晕，热淋涩痛，高脂血症。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "35c0bc613a4ded0c9b0837979d3c61b7c5f3adeb38a8eb471e5ae8d0d4a0e8df"
    },
    {
      "herb": "泽泻",
      "section": "用量",
      "text": "泽泻（Alismatis Rhizoma）用法用量：6～10g。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "f256b9271c1a37388ebb2d82c6703df792da5f6b4d2ac9e6790307ac607bc9d4"
    },
    {
      "herb": "泽泻",
      "section": "毒性",
      "text": "泽泻（Alismatis Rhizoma）毒性：无毒。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "a59d5128d8de37f119149d1fc949f5a234a67d864e4d034b3789d4c60045093a"
    },
    {
      "herb": "泽泻",
      "section": "禁忌",
      "text": "泽泻（Alismatis Rhizoma）用药禁忌：肾虚精滑无湿热者禁服。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "19eb4c42473f39ed309b634a6b80addfae4388d978d67e7fb5d87dfeeab2a1af"
    },
    {
      "herb": "泽泻",
      "section": "性状",
      "text": "泽泻（Alismatis Rhizoma）性状：呈类球形、椭圆形或卵圆形，长 2～7cm，直径 2～6cm。表面黄白色或淡黄棕色，有不规则的横向环状浅沟纹及多数细小突起的须根痕，底部有的有瘤状芽痕。质坚实，断面黄白色，粉性，有多数细孔。气微，味微苦。",
      "source": "《中国药典》2020 年版一部·泽泻【性状】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "fceda0e5fe6052288f973524949ee7b43ab44b71799d571c0852cb2774ee7ca0"
    },
    {
      "herb": "泽泻",
      "section": "炮制",
      "text": "泽泻（Alismatis Rhizoma）炮制：泽泻：除去杂质，稍浸，润透，切厚片，干燥。盐泽泻：取净泽泻片，照盐水炙法（通则 0213）炒至微黄色。",
      "source": "《中国药典》2020 年版一部·泽泻【炮制】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "2aebfe93dc1695d88fa902e28a2c0baed6bb93de1f0ffa73d4396fe3dec98845"
    },
    {
      "herb": "泽泻",
      "section": "产地",
      "text": "泽泻（Alismatis Rhizoma）产地：主产于福建（道地“建泽泻”）、四川、江西（本品为泽泻 Alisma orientale（Sam.）Juzep. 的干燥块茎）",
      "source": "《中国药典》2020 年版一部·泽泻【来源】（A 档）+ 教材（B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "a27b36e3d89ebac75c10d0b726fb7c8a7bf3262ce8269be473e3881c327e1257"
    },
    {
      "herb": "泽泻",
      "section": "鉴别要点",
      "text": "泽泻（Alismatis Rhizoma）鉴别要点：类球形或椭圆形，表面黄白色、有横向环状浅沟纹及细小突起的须根痕，断面黄白色、粉性、有多数细孔，味微苦。",
      "source": "《中国药典》2020 年版一部·泽泻【性状】归纳（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "85568af11b42cfee948ffef3d5bc6ffa6e513784a311677d5639e90bd87defeb"
    }
  ]
}
