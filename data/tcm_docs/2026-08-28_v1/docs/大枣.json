{
  "herb": "大枣",
  "edition": "《中国药典》2020 年版一部",
  "docs": [
    {
      "herb": "大枣",
      "section": "性味归经",
      "text": "大枣（Jujubae Fructus）性味甘，温，归脾、胃、心经。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "8dc71c63dae3afd7cecc087c0832678aeae2e8297648cc4724221b22a19b1fd6"
    },
    {
      "herb": "大枣",
      "section": "功效",
      "text": "大枣（Jujubae Fructus）功效：补中益气，养血安神。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "ba8190dcfe1fcc16d8f2072c05c4b69d791ef2544f2b20a8a54896cce68fa36b"
    },
    {
      "herb": "大枣",
      "section": "主治",
      "text": "大枣（Jujubae Fructus）主治：脾虚食少，乏力便溏，妇人脏躁。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "49fd763c6c5df89ed1f95994dede674234b8526412a2b03018cdc99b6d67ec8e"
    },
    {
      "herb": "大枣",
      "section": "用量",
      "text": "大枣（Jujubae Fructus）用法用量：6～15g。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "df6e3829298eda6028c26ffbb799dd2ebc27bb5f92e5b736a8b17dbde57ce4f3"
    },
    {
      "herb": "大枣",
      "section": "毒性",
      "text": "大枣（Jujubae Fructus）毒性：无毒。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "9cb9cd3d1aacb6da676b148f20f41e21235ff9051c8ad0991f55c59cc6a3d057"
    },
    {
      "herb": "大枣",
      "section": "禁忌",
      "text": "大枣（Jujubae Fructus）用药禁忌：湿盛中满、食积、痰热咳嗽者慎用。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "3ac2130355d11b6cefc8f17ecde37f898c116145f83d6e6c8b2f206b0f5b6287"
    },
    {
      "herb": "大枣",
      "section": "性状",
      "text": "大枣（Jujubae Fructus）性状：呈椭圆形或球形，长 2～3.5cm，直径 1.5～2.5cm。表面暗红色，略带光泽，有不规则皱纹。基部凹陷，有短果梗。外果皮薄，中果皮棕黄色或淡褐色，肉质，柔软，富糖性而油润。果核纺锤形，两端锐尖，质坚硬。气微香，味甜。",
      "source": "《中国药典》2020 年版一部·大枣【性状】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "0d47143f56a6fa67f29d8dac201ff2079764ce5cc6d8d73105c90ef4fbe1e53c"
    },
    {
      "herb": "大枣",
      "section": "炮制",
      "text": "大枣（Jujubae Fructus）炮制：除去杂质，洗净，晒干。或烘至皮软，再行晒干。",
      "source": "《中国药典》2020 年版一部·大枣【炮制】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "f767a8d98fa4234e371fd1bb3e4db6860bb0f15166559208a1123de0668fbb63"
    },
    {
      "herb": "大枣",
      "section": "产地",
      "text": "大枣（Jujubae Fructus）产地：主产于河南（新郑，道地）、河北、山东、山西（本品为鼠李科植物枣 Ziziphus jujuba Mill. 的干燥成熟果实）",
      "source": "《中国药典》2020 年版一部·大枣【来源】（A 档）+ 教材（B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "79eaf95a4e539f375dabe9578a5a4e8dee08c8787a3c385f45d7a3eaf9423e3b"
    },
    {
      "herb": "大枣",
      "section": "鉴别要点",
      "text": "大枣（Jujubae Fructus）鉴别要点：椭圆形或球形，表面暗红色略带光泽、有不规则皱纹，中果皮棕黄色或淡褐色、肉质柔软富糖性而油润，果核纺锤形两端锐尖，气微香，味甜。",
      "source": "《中国药典》2020 年版一部·大枣【性状】归纳（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "0b5a1de91fb4cdb17f472dbcaade6ef98d5b7a2412c1a67a32d0042d6f5c295c"
    }
  ]
}
