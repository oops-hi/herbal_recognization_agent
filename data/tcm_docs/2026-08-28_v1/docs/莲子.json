{
  "herb": "莲子",
  "edition": "《中国药典》2020 年版一部",
  "docs": [
    {
      "herb": "莲子",
      "section": "性味归经",
      "text": "莲子（Nelumbinis Semen）性味甘、涩，平，归脾、肾、心经。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "41b901f21cd423830bb961e59ebdb43cf4f169bff713d031111fd09fe86542d2"
    },
    {
      "herb": "莲子",
      "section": "功效",
      "text": "莲子（Nelumbinis Semen）功效：补脾止泻，止带，益肾涩精，养心安神。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "908dce77549e86001df488f8c717921e0eba129a2e3360721147d7fe8276e15d"
    },
    {
      "herb": "莲子",
      "section": "主治",
      "text": "莲子（Nelumbinis Semen）主治：脾虚泄泻，带下，遗精，心悸失眠。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "a837090f308a478c084bbbcfeb6e8860e5a08349e1b96dabf42fd7b68fab5178"
    },
    {
      "herb": "莲子",
      "section": "用量",
      "text": "莲子（Nelumbinis Semen）用法用量：6～15g。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "5721311b5b8ad80047dc1fef1fa9d0c9d5ae6fa3ec9c30b65935cc4bca319088"
    },
    {
      "herb": "莲子",
      "section": "毒性",
      "text": "莲子（Nelumbinis Semen）毒性：无毒。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "083eb05340e80f2a74215b5f8df4ba71bb33446e99d8dc58c36a58843f6fc4d8"
    },
    {
      "herb": "莲子",
      "section": "禁忌",
      "text": "莲子（Nelumbinis Semen）用药禁忌：中满痞胀及大便燥结者忌服。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "3912f53fa6adee313b12de7a23a185d4dd8e376431ac7e49ae7ec3092041d52e"
    },
    {
      "herb": "莲子",
      "section": "性状",
      "text": "莲子（Nelumbinis Semen）性状：呈略呈椭圆形或类球形，长 1.2～1.8cm，直径 0.8～1.4cm。表面浅黄棕色至红棕色，有细纵纹和较宽的脉纹。一端中心呈乳头状突起，深棕色，多有裂口，其周边略下陷。质硬，种皮薄，不易剥离。子叶 2，黄白色，肥厚，中有空隙，具绿色莲子心。气微，味甘、微涩；莲子心味苦。",
      "source": "《中国药典》2020 年版一部·莲子【性状】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "26ad1bad9a5a00f3820fb4f2d7350fdd54375561293c492430ce9e7bdf4b10af"
    },
    {
      "herb": "莲子",
      "section": "炮制",
      "text": "莲子（Nelumbinis Semen）炮制：略浸，润透，切开，去心，干燥。",
      "source": "《中国药典》2020 年版一部·莲子【炮制】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "c56609421d5f43e3b0a646e6e8d2c8aae79efe3010c36097e2e143fb90b81226"
    },
    {
      "herb": "莲子",
      "section": "产地",
      "text": "莲子（Nelumbinis Semen）产地：主产于湖南（道地“湘莲”）、江西（广昌）、福建（本品为睡莲科植物莲 Nelumbo nucifera Gaertn. 的干燥成熟种子）",
      "source": "《中国药典》2020 年版一部·莲子【来源】（A 档）+ 教材（B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "2dab70083b47bb42424629cf8e387957a10897d767ee572d7d9c892a6dbd6c88"
    },
    {
      "herb": "莲子",
      "section": "鉴别要点",
      "text": "莲子（Nelumbinis Semen）鉴别要点：椭圆形或类球形，表面浅黄棕色至红棕色、有细纵纹和较宽的脉纹，一端中心呈乳头状突起（深棕色、周边略下陷），子叶黄白色肥厚、中含绿色莲子心（去心者为莲肉），味甘微涩。与芡实区别：莲子大（长 1.2～1.8cm）、有绿色莲子心；芡实小（直径 5～8mm）、无莲子心。",
      "source": "《中国药典》2020 年版一部·莲子【性状】归纳 + 中药鉴定学教材（A/B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "bda2f2ed77d7ef07faaa9adf3786ea65c2bbf9471bcac0bbc1ffff601efcf865"
    },
    {
      "herb": "莲子",
      "section": "相似对比",
      "text": "莲子（Nelumbinis Semen）与「芡实」鉴别（同为水生植物种子类饮片，浅色系，易混淆）：本品（莲子）：椭圆形或类球形，长 1.2～1.8cm，一端中心乳头状突起深棕色，子叶黄白色肥厚、中有空隙，含绿色莲子心；对比药（芡实）：类球形，直径 5～8mm，有棕红色内种皮、一端黄白色占 1/3，断面白色粉性，无莲子心",
      "source": "中药鉴定学教材/药典对照（A/B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "e6c7cfc85394184b7213d28f9929897e03687b4fb4a982315f5425e2eb28eee2"
    }
  ]
}
