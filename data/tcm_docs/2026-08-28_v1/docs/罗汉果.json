{
  "herb": "罗汉果",
  "edition": "《中国药典》2020 年版一部",
  "docs": [
    {
      "herb": "罗汉果",
      "section": "性味归经",
      "text": "罗汉果（Siraitiae Fructus）性味甘，凉，归肺、大肠经。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "37b59d1940e48893a6e25af7484468d2f53ec710c0dadf1add928a620315ab2d"
    },
    {
      "herb": "罗汉果",
      "section": "功效",
      "text": "罗汉果（Siraitiae Fructus）功效：清热润肺，利咽开音，滑肠通便。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "b7491d001fa13ad1f31cfeaa06c26cdb4788979660515fe5427318b63de8fc27"
    },
    {
      "herb": "罗汉果",
      "section": "主治",
      "text": "罗汉果（Siraitiae Fructus）主治：肺热燥咳，咽痛失音，肠燥便秘。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "9179711f7b2ea54dedd5bbcf8b7cfb88c3d9b3e52e0aebbf9cb0a60c02bfc969"
    },
    {
      "herb": "罗汉果",
      "section": "用量",
      "text": "罗汉果（Siraitiae Fructus）用法用量：9～15g。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "120f97b25f109552b0425f45f62855f6329e26a32d9f43791874783e048db84a"
    },
    {
      "herb": "罗汉果",
      "section": "毒性",
      "text": "罗汉果（Siraitiae Fructus）毒性：无毒。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "54202d79f231d0c5c9e2b10290e6586f02df4b4e22dfa34ef8626acfbacc253e"
    },
    {
      "herb": "罗汉果",
      "section": "禁忌",
      "text": "罗汉果（Siraitiae Fructus）用药禁忌：无。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "474c5d983e0093b964b45f793f3cc02eca6a618acd81622db255c57193ef0401"
    },
    {
      "herb": "罗汉果",
      "section": "性状",
      "text": "罗汉果（Siraitiae Fructus）性状：呈卵形、椭圆形或球形，长 4.5～8.5cm，直径 3.5～6cm。表面褐色、黄褐色或绿褐色，有深色斑块及黄色柔毛，有的具 6～11 条纵纹。顶端有花柱残痕，基部有果梗痕。体轻，质脆，果皮薄，易破。果瓤（中、内果皮）海绵状，浅棕色。种子扁圆形，多数，长约 1.5cm，宽约 1.2cm；浅红色至棕红色，两面中间微凹陷，四周有放射状沟纹，边缘有槽。气微，味甜。",
      "source": "《中国药典》2020 年版一部·罗汉果【性状】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "055e0f0cc2b712259c8c76afc2d3911d47df391067825f9b667f80fc40cd2763"
    },
    {
      "herb": "罗汉果",
      "section": "炮制",
      "text": "罗汉果（Siraitiae Fructus）炮制：除去杂质。",
      "source": "《中国药典》2020 年版一部·罗汉果【炮制】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "8630717e5f0b06aea60a2675410db7e63d9801c64d95b3e44201e243a593d30e"
    },
    {
      "herb": "罗汉果",
      "section": "产地",
      "text": "罗汉果（Siraitiae Fructus）产地：主产于广西（永福，道地“永福罗汉果”）（本品为葫芦科植物罗汉果 Siraitia grosvenorii（Swingle）C. Jeffrey ex A. M. Lu et Z. Y. Zhang 的干燥果实）",
      "source": "《中国药典》2020 年版一部·罗汉果【来源】（A 档）+ 教材（B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "87c867efe71c29b4b1eec7b18297a057609462e43fc3813e428b8556db4d3984"
    },
    {
      "herb": "罗汉果",
      "section": "鉴别要点",
      "text": "罗汉果（Siraitiae Fructus）鉴别要点：卵形或球形，表面褐色或黄褐色、有深色斑块及黄色柔毛，体轻质脆、果皮薄易破，果瓤海绵状浅棕色，种子扁圆形、边缘有槽，味甜。",
      "source": "《中国药典》2020 年版一部·罗汉果【性状】归纳（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "8dc4b03eb2326d8b165ea12e990e9a427b4cf159e8abea1569062b458c6fa3a7"
    }
  ]
}
