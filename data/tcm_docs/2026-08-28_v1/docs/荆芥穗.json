  "docs": [
    {
      "herb": "荆芥穗",
      "section": "性味归经",
      "text": "荆芥穗（Schizonepetae Spica）性味辛，微温，归肺、肝经。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "fe2b0dcd692216f863682659d8387da0c2018d9477ee2e6de5e3b680bc273135"
    },
    {
      "herb": "荆芥穗",
      "section": "功效",
      "text": "荆芥穗（Schizonepetae Spica）功效：解表散风，透疹，消疮。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "e7beebdc843adcb6fe24a8ef7ed0c3d71dc8f2b5446236c8a0761fd0044d1307"
    },
    {
      "herb": "荆芥穗",
      "section": "主治",
      "text": "荆芥穗（Schizonepetae Spica）主治：感冒，头痛，麻疹，风疹，疮疡初起。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "163a81bd3cf4335a9abd9f4f34bbb925351b22b0c500e34288bf71600ef029c4"
    },
    {
      "herb": "荆芥穗",
      "section": "用量",
      "text": "荆芥穗（Schizonepetae Spica）用法用量：5～10g。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "1e9bb3c6e4dc18a4511aa8060042d386c9c1130b2d5a6f174396a34b0fdca122"
    },
    {
      "herb": "荆芥穗",
      "section": "毒性",
      "text": "荆芥穗（Schizonepetae Spica）毒性：无毒。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "669f2097a94ddaf737861b23c3f6f8a1dde72b8437c757404c0b030232efdd40"
    },
    {
      "herb": "荆芥穗",
      "section": "禁忌",
      "text": "荆芥穗（Schizonepetae Spica）用药禁忌：表虚自汗者不宜用。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "d9656f25011ee6795e599ae6e1ab3d59443b0516db5795527dae67099bba41b1"
    },
    {
      "herb": "荆芥穗",
      "section": "性状",
      "text": "荆芥穗（Schizonepetae Spica）性状：为荆芥的花序，呈穗状，长 3～5cm。花冠多脱落，宿萼钟形，顶端 5 齿裂，淡棕色或黄绿色，被短柔毛，内藏棕黑色小坚果。气芳香，味微涩而辛凉。",
      "source": "《中国药典》2020 年版一部·荆芥穗【性状】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "9d0a81f8d752a71233dc8a61f246b845dbd984183893dd53c5568a793715fc7a"
    },
    {
      "herb": "荆芥穗",
      "section": "炮制",
      "text": "荆芥穗（Schizonepetae Spica）炮制：荆芥穗：除去杂质，喷淋清水，稍润，切段，晒干。荆芥穗炭：取净荆芥穗段，照炒炭法（通则 0213）炒至表面焦黑色。",
      "source": "《中国药典》2020 年版一部·荆芥穗【炮制】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "22d61e8584e11d72fe3994d2480d5126ab24babbc012866e6ab4dc29d110549f"
    },
    {
      "herb": "荆芥穗",
      "section": "产地",
      "text": "荆芥穗（Schizonepetae Spica）产地：主产于江苏、浙江、河北、江西（本品为荆芥 Schizonepeta tenuifolia Briq. 的干燥花穗）",
      "source": "《中国药典》2020 年版一部·荆芥穗【来源】（A 档）+ 教材（B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "fbead760dbe942eea812fba4f51013d7d3532d5634b91119d7ff4c714796c283"
    },
    {
      "herb": "荆芥穗",
      "section": "鉴别要点",
      "text": "荆芥穗（Schizonepetae Spica）鉴别要点：穗状轮伞花序，宿萼钟形、顶端 5 齿裂、淡棕色或黄绿色被短柔毛，内藏棕黑色小坚果，气芳香，味微涩而辛凉。与薄荷区别：薄荷为带叶茎段、方柱形茎；荆芥穗为花穗、无茎叶段。",
      "source": "《中国药典》2020 年版一部·荆芥穗【性状】归纳（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "97c44a9a79c03e31a19176fde2a42eca057c16f2717a5ae00486236fd074483d"
    }
  ]
}
