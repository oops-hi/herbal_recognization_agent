{
  "herb": "山药",
  "edition": "《中国药典》2020 年版一部",
  "docs": [
    {
      "herb": "山药",
      "section": "性味归经",
      "text": "山药（Dioscoreae Rhizoma）性味甘，平，归脾、肺、肾经。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "a51b4885ef24252cf4583d01cb460e719c97f53a600c9bcf4ed698cd4a2ddaeb"
    },
    {
      "herb": "山药",
      "section": "功效",
      "text": "山药（Dioscoreae Rhizoma）功效：补脾养胃，生津益肺，补肾涩精。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "a46ed32691e342ff7e4699eaadbcce7dad36ed23b834460b801cbbe299a114f0"
    },
    {
      "herb": "山药",
      "section": "主治",
      "text": "山药（Dioscoreae Rhizoma）主治：脾虚食少，久泻不止，肺虚喘咳，肾虚遗精，带下，尿频，虚热消渴。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "1581f7fd455f8988b0d1198343ba40759503c418b209d72aa702b251fe320c6c"
    },
    {
      "herb": "山药",
      "section": "用量",
      "text": "山药（Dioscoreae Rhizoma）用法用量：15～30g。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "5462244b7adeb96697754c95bef60c432626c52f843627a3d797dd0d13106a93"
    },
    {
      "herb": "山药",
      "section": "毒性",
      "text": "山药（Dioscoreae Rhizoma）毒性：无毒。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "79ec281f7bf6b31a357f03ccdfb0503ca79747a5c2807509ef430390f449ba44"
    },
    {
      "herb": "山药",
      "section": "禁忌",
      "text": "山药（Dioscoreae Rhizoma）用药禁忌：湿盛中满或有实邪、积滞者不宜使用。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "8016cd66a38ead9dfc1857855993d36fe0e8358905ef3e757cb56200e45aeecc"
    },
    {
      "herb": "山药",
      "section": "性状",
      "text": "山药（Dioscoreae Rhizoma）性状：呈类圆形厚片，切面白色或淡黄白色，富粉性。周边淡黄白色，偶见点状红棕色皮孔。气微，味微酸，嚼之发黏。",
      "source": "《中国药典》2020 年版一部·山药【性状】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "7f7ed1bb74f9925a3b68a35c65f53b8475b2036bf54a31dbbb6f97169e9bac80"
    },
    {
      "herb": "山药",
      "section": "炮制",
      "text": "山药（Dioscoreae Rhizoma）炮制：山药：除去杂质，分开大小个，泡润至透，切厚片，干燥。麸炒山药：取净山药片，照麸炒法（通则 0213）炒至黄色。",
      "source": "《中国药典》2020 年版一部·山药【炮制】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "611f1498c47d2a89ba23d6d66c6b829973b1e4d10d1aed12a6d96e1001266534"
    },
    {
      "herb": "山药",
      "section": "产地",
      "text": "山药（Dioscoreae Rhizoma）产地：主产于河南（焦作，道地“怀山药”）、山西、河北（本品为薯蓣 Dioscorea opposita Thunb. 的干燥根茎）",
      "source": "《中国药典》2020 年版一部·山药【来源】（A 档）+ 教材（B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "32169e340b941f5a281fbb01241b6cd8f1e4686387111f08a2e39ae64892c5ca"
    },
    {
      "herb": "山药",
      "section": "鉴别要点",
      "text": "山药（Dioscoreae Rhizoma）鉴别要点：类圆形厚片，切面白色或淡黄白色、富粉性，周边淡黄白色、偶见点状红棕色皮孔，味微酸，嚼之发黏。与茯苓区别：茯苓切面颗粒性、味淡嚼之粘牙；山药粉性、味微酸嚼之发黏。",
      "source": "《中国药典》2020 年版一部·山药【性状】归纳 + 中药鉴定学教材（A/B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "112fd973c18a54c1d80f177c20adb422c995379252b46a5d1b0382ad94c731b9"
    },
    {
      "herb": "山药",
      "section": "相似对比",
      "text": "山药（Dioscoreae Rhizoma）与「茯苓」鉴别（同为白色系块片饮片，色近易混）：本品（山药）：类圆形厚片，切面白色、富粉性，周边偶见点状红棕色皮孔，味微酸、嚼之发黏；对比药（茯苓）：方块状，切面白色、颗粒性、有的有裂隙，外皮棕褐色、皱缩，味淡、嚼之粘牙",
      "source": "中药鉴定学教材/药典对照（A/B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "91d608bb8186750dda9a18da440507789c17850322b947e865efc8c1d7ab6e35"
    }
  ]
}
