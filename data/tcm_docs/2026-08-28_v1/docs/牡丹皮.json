{
  "herb": "牡丹皮",
  "edition": "《中国药典》2020 年版一部",
  "docs": [
    {
      "herb": "牡丹皮",
      "section": "性味归经",
      "text": "牡丹皮（Moutan Cortex）性味苦、辛，微寒，归心、肝、肾经。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "06efac5fa132bc7b582a68a04de18d617b008ad0dc2d8e8450fbc686ae372421"
    },
    {
      "herb": "牡丹皮",
      "section": "功效",
      "text": "牡丹皮（Moutan Cortex）功效：清热凉血，活血化瘀。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "12c916a373b48e6641485050c619339cd9528db6e59955650e1138f3c0d65220"
    },
    {
      "herb": "牡丹皮",
      "section": "主治",
      "text": "牡丹皮（Moutan Cortex）主治：热入营血，温毒发斑，吐血衄血，夜热早凉，无汗骨蒸，经闭痛经，跌扑伤痛，痈肿疮毒。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "020d3fcd82367f6cded6de5d7b8b98d0ec7f46a72f7544cd4edfab0285f914c9"
    },
    {
      "herb": "牡丹皮",
      "section": "用量",
      "text": "牡丹皮（Moutan Cortex）用法用量：6～12g。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "859cddcb7ae248e44cd345c2bf0ecf731cfe3c48302f23b1adad2eccadc0fa5d"
    },
    {
      "herb": "牡丹皮",
      "section": "毒性",
      "text": "牡丹皮（Moutan Cortex）毒性：无毒。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "1780dabbb8ca1cbd5eef906bc5aeb02d0977f37c26fe65c31e4928fcdede9eb2"
    },
    {
      "herb": "牡丹皮",
      "section": "禁忌",
      "text": "牡丹皮（Moutan Cortex）用药禁忌：血虚有寒、月经过多及孕妇不宜用。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "9cf5ab6bf26db54f703a56109fe498ba036a7e8b67756e81969c2ecd38a780e6"
    },
    {
      "herb": "牡丹皮",
      "section": "性状",
      "text": "牡丹皮（Moutan Cortex）性状：呈圆形或卷曲的半圆形厚片，外表面灰褐色或黄褐色，栓皮脱落处粉红色；内表面淡灰黄色或浅棕色，有明显的细纵纹，常见发亮的结晶。切面淡粉红色，粉性。气芳香，味微苦而涩。",
      "source": "《中国药典》2020 年版一部·牡丹皮【性状】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "9123df3c4f2c861751cd83ed0d5732df3dcb4ca738f0320c5563a4181aaac804"
    },
    {
      "herb": "牡丹皮",
      "section": "炮制",
      "text": "牡丹皮（Moutan Cortex）炮制：迅速洗净，润后切薄片，晒干。",
      "source": "《中国药典》2020 年版一部·牡丹皮【炮制】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "6020badb5344b12b2527a876483564edb95f2d36fda7c5496c3d287c7880e623"
    },
    {
      "herb": "牡丹皮",
      "section": "产地",
      "text": "牡丹皮（Moutan Cortex）产地：主产于安徽（铜陵凤凰山，道地“凤丹”）、湖南、山东（本品为牡丹 Paeonia suffruticosa Andr. 的干燥根皮）",
      "source": "《中国药典》2020 年版一部·牡丹皮【来源】（A 档）+ 教材（B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "4ecfbe946052d5ca14fc2c9d3219c5e141a53e2260d42f19cf00396f4ec44350"
    },
    {
      "herb": "牡丹皮",
      "section": "鉴别要点",
      "text": "牡丹皮（Moutan Cortex）鉴别要点：卷曲半圆形厚片，内表面淡灰黄色、有细纵纹并常见发亮的结晶（丹皮酚结晶），切面淡粉红色、粉性，气芳香，味微苦而涩。",
      "source": "《中国药典》2020 年版一部·牡丹皮【性状】归纳 + 中药鉴定学教材（A/B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "29e3005ef7b0d15365cd051bf28e1342ef7abed054df751be795a44b7f3af1d1"
    }
  ]
}
