{
  "herb": "莱菔子",
  "edition": "《中国药典》2020 年版一部",
  "docs": [
    {
      "herb": "莱菔子",
      "section": "性味归经",
      "text": "莱菔子（Raphani Semen）性味辛、甘，平，归肺、脾、胃经。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "dcdebb26f414f157b1829f78b635311eb0ace1e6c12b469357a96b06cf54992b"
    },
    {
      "herb": "莱菔子",
      "section": "功效",
      "text": "莱菔子（Raphani Semen）功效：消食除胀，降气化痰。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "cf82060cede4b92cf6fa78782101f8274d2879bed67f408a5bebfaccb3dd247f"
    },
    {
      "herb": "莱菔子",
      "section": "主治",
      "text": "莱菔子（Raphani Semen）主治：饮食停滞，脘腹胀痛，大便秘结，积滞泻痢，痰壅喘咳。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "3e4016a8599d2e9b0e546a3980318dba7b3b065335dbdea1d2dd7874417bc748"
    },
    {
      "herb": "莱菔子",
      "section": "用量",
      "text": "莱菔子（Raphani Semen）用法用量：5～12g。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "29c31c92223b882c09a6ed039b9edf93c042bbd084350655354e4a79998c14d7"
    },
    {
      "herb": "莱菔子",
      "section": "毒性",
      "text": "莱菔子（Raphani Semen）毒性：无毒。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "31743872e370af0cf69c14a1dffd497629e7b5afe97f681c6913e5af1c94a14f"
    },
    {
      "herb": "莱菔子",
      "section": "禁忌",
      "text": "莱菔子（Raphani Semen）用药禁忌：气虚者慎用。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "593ab30478bc9a0f924d71d222d7289372e63d8ad21eb5735e14c691f1979c49"
    },
    {
      "herb": "莱菔子",
      "section": "性状",
      "text": "莱菔子（Raphani Semen）性状：呈卵圆形或椭圆形，稍扁，长 2.5～4mm，宽 2～3mm。表面黄棕色、红棕色或灰棕色，一端有深棕色圆形种脐，一侧有数条纵沟。种皮薄而脆，子叶 2，黄白色，有油性。气微，味淡、微苦辛。",
      "source": "《中国药典》2020 年版一部·莱菔子【性状】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "6fa1dd8535b02ccca068f7d63cf242c97b30e982476e69794a3ee76a6407c6c7"
    },
    {
      "herb": "莱菔子",
      "section": "炮制",
      "text": "莱菔子（Raphani Semen）炮制：莱菔子：除去杂质，洗净，干燥。炒莱菔子：取净莱菔子，照清炒法（通则 0213）炒至微鼓起。",
      "source": "《中国药典》2020 年版一部·莱菔子【炮制】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "cbcb4802d0a316375593b5ff2b676c5b92d6e51b51eef008234c76c6ae8ee97b"
    },
    {
      "herb": "莱菔子",
      "section": "产地",
      "text": "莱菔子（Raphani Semen）产地：主产于河北、河南、浙江、安徽（本品为十字花科植物萝卜 Raphanus sativus L. 的干燥成熟种子）",
      "source": "《中国药典》2020 年版一部·莱菔子【来源】（A 档）+ 教材（B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "4e030c11c59d0d27d2f7e1d90d5ee07f0954bdf75a7a24fe961c5a6dcde2bff0"
    },
    {
      "herb": "莱菔子",
      "section": "鉴别要点",
      "text": "莱菔子（Raphani Semen）鉴别要点：卵圆形或椭圆形稍扁，表面黄棕色或灰棕色，一端有深棕色圆形种脐、一侧有数条纵沟，种皮薄而脆，子叶黄白色有油性，味微苦辛。",
      "source": "《中国药典》2020 年版一部·莱菔子【性状】归纳（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "b1635ecd36109c86696c2e168e1da4f70a8517c88bb7c0d31e5ab93e009771b6"
    }
  ]
}
