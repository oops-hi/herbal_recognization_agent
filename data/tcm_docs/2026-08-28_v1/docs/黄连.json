{
  "herb": "黄连",
  "edition": "《中国药典》2020 年版一部",
  "docs": [
    {
      "herb": "黄连",
      "section": "性味归经",
      "text": "黄连（Coptidis Rhizoma）性味苦，寒，归心、脾、胃、肝、胆、大肠经。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "9b8e45e25d82fe6546a7610256b5688fa74f86da13705979da1cf36a502b7439"
    },
    {
      "herb": "黄连",
      "section": "功效",
      "text": "黄连（Coptidis Rhizoma）功效：清热燥湿，泻火解毒。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "ea392268d25287929fce9f0f61bdb37b902e158ed582c9ed02061be51a390741"
    },
    {
      "herb": "黄连",
      "section": "主治",
      "text": "黄连（Coptidis Rhizoma）主治：湿热痞满，呕吐吞酸，泻痢，黄疸，高热神昏，心火亢盛，心烦不寐，心悸不宁，血热吐衄，目赤，牙痛，消渴，痈肿疔疮；外治湿疹、湿疮、耳道流脓。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "423eda8bd649c4b4c20e82aaba35294c6e07f8d3bee98fe42e0f75f0c2608a94"
    },
    {
      "herb": "黄连",
      "section": "用量",
      "text": "黄连（Coptidis Rhizoma）用法用量：2～5g。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "f27a046dfea33c2833578fa1afa24493bc4f35940da1aafa607f5f27884fa65f"
    },
    {
      "herb": "黄连",
      "section": "毒性",
      "text": "黄连（Coptidis Rhizoma）毒性：无毒。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "ba66602454d4c56405a7ed8df18281928f5c6adeff8e3f0f9c4269cef7a21851"
    },
    {
      "herb": "黄连",
      "section": "禁忌",
      "text": "黄连（Coptidis Rhizoma）用药禁忌：脾胃虚寒者忌用；苦燥伤阴，阴虚津伤者慎用。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "44bce53191831075bd2f4ee94ce26aa3f05de309e3108b1140949d9efd71b3e3"
    },
    {
      "herb": "黄连",
      "section": "性状",
      "text": "黄连（Coptidis Rhizoma）性状：呈不规则的薄片。切面鲜黄色或红黄色，具放射状纹理，髓部有的中空。周边暗黄色，粗糙，有不规则细纵纹及须根残基。质硬。气微，味极苦。",
      "source": "《中国药典》2020 年版一部·黄连【性状】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "ad718ff2e0d21b20d1923ff12108fe19b50539468e6351dca86679b0b373665d"
    },
    {
      "herb": "黄连",
      "section": "炮制",
      "text": "黄连（Coptidis Rhizoma）炮制：黄连：除去杂质，润透后切薄片，干燥，或用时捣碎。酒黄连：取净黄连，照酒炙法（通则 0213）炒干。姜黄连：取净黄连，照姜汁炙法（通则 0213）炒干。萸黄连：取净黄连，照吴茱萸汁炙法（通则 0213）炒干。",
      "source": "《中国药典》2020 年版一部·黄连【炮制】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "314aa4268af190f4d2437117fe94c8c66cb7909fd9f8b1a261ced7472754655e"
    },
    {
      "herb": "黄连",
      "section": "产地",
      "text": "黄连（Coptidis Rhizoma）产地：主产于重庆（石柱，道地）、四川、湖北（本品为毛茛科植物黄连 Coptis chinensis Franch.、三角叶黄连 C. deltoidea C. Y. Cheng et Hsiao 或云连 C. teeta Wall. 的干燥根茎）",
      "source": "《中国药典》2020 年版一部·黄连【来源】（A 档）+ 教材（B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "3506b8a64eecd4787a2a315fc61a547b03fbec563393067144318f4aeb1269c8"
    },
    {
      "herb": "黄连",
      "section": "鉴别要点",
      "text": "黄连（Coptidis Rhizoma）鉴别要点：不规则薄片，切面鲜黄色或红黄色、具放射状纹理，髓部有的中空，周边暗黄色、粗糙，味极苦（苦味极强为黄连经典特征）。",
      "source": "《中国药典》2020 年版一部·黄连【性状】归纳（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "ad82f50843511be9580981c7b0787e8c5bc8f7693346aa67b362ef5ebd1b2397"
    }
  ]
}
