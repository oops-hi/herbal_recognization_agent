{
  "herb": "半夏",
  "edition": "《中国药典》2020 年版一部",
  "docs": [
    {
      "herb": "半夏",
      "section": "性味归经",
      "text": "半夏（Pinelliae Rhizoma）性味辛，温；有毒，归脾、胃、肺经。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "a0c0058c3496c36ec8a6704e4f9bc65bc02f550ec1a33226f2107243bd07bf22"
    },
    {
      "herb": "半夏",
      "section": "功效",
      "text": "半夏（Pinelliae Rhizoma）功效：燥湿化痰，降逆止呕，消痞散结。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "06c04682c7a282dd6776a82d10199b9da32caecec0f1f7becf1d2bbf13a437bc"
    },
    {
      "herb": "半夏",
      "section": "主治",
      "text": "半夏（Pinelliae Rhizoma）主治：湿痰寒痰，咳喘痰多，痰饮眩悸，风痰眩晕，痰厥头痛，呕吐反胃，胸脘痞闷，梅核气；生用外治痈肿痰核。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "bf1b0dcaa3e339325b7166c293e70f079b3330b7947280de6498b4d4c16612b3"
    },
    {
      "herb": "半夏",
      "section": "用量",
      "text": "半夏（Pinelliae Rhizoma）用法用量：3～9g。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "c1ac6cbf484df215d84249e72548601f8a1fd50bcae576e1f76e04ffbdf65628"
    },
    {
      "herb": "半夏",
      "section": "毒性",
      "text": "半夏（Pinelliae Rhizoma）毒性：有毒。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "c03eef0e67707db9b89517b29567bfddfaf312bb39cbaf48f7e075f30b388e66"
    },
    {
      "herb": "半夏",
      "section": "禁忌",
      "text": "半夏（Pinelliae Rhizoma）用药禁忌：不宜与川乌、制川乌、草乌、制草乌、附子同用（十八反）；阴虚燥咳、血证、热痰、燥痰慎用；生品内服宜慎。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "34428c68291259de99ba6397e25a2b5f9b6ce909aa31d4289c5402a921a557e0"
    },
    {
      "herb": "半夏",
      "section": "性状",
      "text": "半夏（Pinelliae Rhizoma）性状：呈类圆形或不规则的厚片。切面灰白色至淡灰棕色，粉性，可见多数散在的黄色白点（草酸钙针晶束），有时可见偏心性的半圆形或圆形空洞。周边淡黄色，有凹凸不平的皱纹。质坚实。气微，味辛辣、麻舌而刺喉。",
      "source": "《中国药典》2020 年版一部·半夏【性状】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "6eb115d55ea1be0fa474ed85d4a641ae0b3a07f153360b0dd2addfd93f55e117"
    },
    {
      "herb": "半夏",
      "section": "炮制",
      "text": "半夏（Pinelliae Rhizoma）炮制：清半夏：取净半夏，大小分开，用白矾溶液浸泡至内无干心，取出，洗净，切厚片，干燥。法半夏：取净半夏，大小分开，用水浸泡至内无干心，另取甘草煎液倒入用适量石灰水配制的石灰液中，加入已浸透的半夏，浸泡并保持浸液 pH 值 12 以上，至剖面黄色均匀、口尝微有麻舌感时，取出，洗净，阴干或烘干。",
      "source": "《中国药典》2020 年版一部·半夏【炮制】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "c8e4541da30be810baf432e1db5f5e5a9b2936c6e43c6256d948ef0ca645af07"
    },
    {
      "herb": "半夏",
      "section": "产地",
      "text": "半夏（Pinelliae Rhizoma）产地：主产于湖北（道地“荆半夏”）、四川、甘肃（本品为天南星科植物半夏 Pinellia ternata（Thunb.）Breit. 的干燥块茎）",
      "source": "《中国药典》2020 年版一部·半夏【来源】（A 档）+ 教材（B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "01f1807c67dec363fc6791025d2ca643297df730b51b16d6b16bae9a6d2c62ca"
    },
    {
      "herb": "半夏",
      "section": "鉴别要点",
      "text": "半夏（Pinelliae Rhizoma）鉴别要点：类圆形厚片，切面灰白色至淡灰棕色、粉性，可见黄色白点（草酸钙针晶束）及偏心性圆形空洞（半夏“肚脐眼”特征），味辛辣、麻舌而刺喉。生品有毒，药用须炮制（法半夏/清半夏/姜半夏）。",
      "source": "《中国药典》2020 年版一部·半夏【性状】归纳 + 中药鉴定学教材（A/B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "5fb85fa54e076da2e1c52473e3b9b60b83bbe4566864657b8864d513f6e447d9"
    }
  ]
}
