{
  "herb": "枸杞子",
  "edition": "《中国药典》2020 年版一部",
  "docs": [
    {
      "herb": "枸杞子",
      "section": "性味归经",
      "text": "枸杞子（Lycii Fructus）性味甘，平，归肝、肾经。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "1cf6358062e403647b6633141922b631d4fbccdc335dc43651fd221e3bec5ea2"
    },
    {
      "herb": "枸杞子",
      "section": "功效",
      "text": "枸杞子（Lycii Fructus）功效：滋补肝肾，益精明目。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "6c8d1332e5b74ecbdcae61e41233617920a3e4894231faedbe604ead16a794a4"
    },
    {
      "herb": "枸杞子",
      "section": "主治",
      "text": "枸杞子（Lycii Fructus）主治：虚劳精亏，腰膝酸痛，眩晕耳鸣，阳痿遗精，内热消渴，血虚萎黄，目昏不明。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "497085a9162a24f86e58734c84274935d755c74df2b981ac783f16cc27ac6b2c"
    },
    {
      "herb": "枸杞子",
      "section": "用量",
      "text": "枸杞子（Lycii Fructus）用法用量：6～12g。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "e743dbe4c74294fccab05bff703fe23a7e1e6b93efe2f2159d5e9e8416aced85"
    },
    {
      "herb": "枸杞子",
      "section": "毒性",
      "text": "枸杞子（Lycii Fructus）毒性：无毒。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "dc637712ea117c14dda1942160ae69e0fa43191591c22d3c7ea6b5e0568ccb08"
    },
    {
      "herb": "枸杞子",
      "section": "禁忌",
      "text": "枸杞子（Lycii Fructus）用药禁忌：脾虚便溏者慎用。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "a0a22515ddf1abb40c9533ebe139b7fbead5ad7021a2dfe95a32533b399fab5e"
    },
    {
      "herb": "枸杞子",
      "section": "性状",
      "text": "枸杞子（Lycii Fructus）性状：类纺锤形或椭圆形，长 6～20mm，直径 3～10mm。表面红色或暗红色，顶端有小突起状的花柱痕，基部有白色的果梗痕。果皮柔韧，皱缩；果肉肉质，柔润而有黏性。气微，味甜。",
      "source": "《中国药典》2020 年版一部·枸杞子【性状】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "aa9f8d191b3ecbdb25d2b2a8f44ef9c429db7d75cdffc307e3e9df0817cea105"
    },
    {
      "herb": "枸杞子",
      "section": "炮制",
      "text": "枸杞子（Lycii Fructus）炮制：除去杂质，摘去残留的梗和蒂。",
      "source": "《中国药典》2020 年版一部·枸杞子【炮制】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "8e7d2d56ba4ba300e7bbdf4efb5f7b8b06026f5c4a96332788e8be67d25fbaf0"
    },
    {
      "herb": "枸杞子",
      "section": "产地",
      "text": "枸杞子（Lycii Fructus）产地：主产于宁夏、甘肃、青海、新疆等地；宁夏中宁为道地产区（枸杞子为宁夏枸杞 Lycium barbarum L. 的干燥成熟果实）",
      "source": "《中药学》教材·枸杞子（B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "5cb5e05d6303f26d0e059f22750bdc9c4cad1832cdb9414469c270100ac3bf49"
    },
    {
      "herb": "枸杞子",
      "section": "鉴别要点",
      "text": "枸杞子（Lycii Fructus）鉴别要点：类纺锤形，表面红色或暗红色，具不规则皱纹，果肉柔韧、有黏性，种子扁肾形、黄棕色，味甜。与五味子区别：五味子为球形浆果，紫红色或暗红色，种子仅 1 粒，表面光滑。",
      "source": "《中国药典》2020 年版一部·枸杞子【性状】归纳 + 中药鉴定学教材（A/B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "b0d12f1e21449928e4601d5b9a7de184c6dfefceab0c2fa109871140b6718151"
    },
    {
      "herb": "枸杞子",
      "section": "相似对比",
      "text": "枸杞子（Lycii Fructus）与「五味子」鉴别（外观相近，干燥浆果类易混淆）：本品（枸杞子）：类纺锤形，表面红色或暗红色，果肉厚而柔润有黏性，种子扁肾形（20～50 粒），味甜；对比药（五味子）：球形，表面紫红色或暗红色，有皱缩，种子仅 1 粒、肾形光滑，味酸",
      "source": "中药鉴定学教材/药典对照（A/B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "28b7df694bd5946e9552dc48733e9461d169acb4b0a9a006985dd3a27f948998"
    },
    {
      "herb": "枸杞子",
      "section": "相似对比",
      "text": "枸杞子（Lycii Fructus）与「桑椹」鉴别（同为深红色小果实类饮片，色泽相近）：本品（枸杞子）：纺锤形或椭圆形浆果，表面鲜红色或暗红色、具不规则皱纹、顶端有小突起状花柱痕，质柔软，味甘、微苦；对比药（桑椹）：聚花果长圆形，黄棕色至暗紫色，由多数小瘦果集合而成、外具肉质花被片 4 枚，味微酸而甜",
      "source": "中药鉴定学教材/药典对照（A/B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "17f5dedce228dee8c3d28be03016115a2d87032e8f67c808b44caac25efa29ff"
    }
  ]
}
