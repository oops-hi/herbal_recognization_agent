{
  "herb": "薏苡仁",
  "edition": "《中国药典》2020 年版一部",
  "docs": [
    {
      "herb": "薏苡仁",
      "section": "性味归经",
      "text": "薏苡仁（Coicis Semen）性味甘、淡，凉，归脾、胃、肺经。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "e9e97281a7e6eb7acc8e60444fbb2655e0485b31c6c80b04023e8fc2d68c58e6"
    },
    {
      "herb": "薏苡仁",
      "section": "功效",
      "text": "薏苡仁（Coicis Semen）功效：利水渗湿，健脾止泻，除痹，排脓，解毒散结。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "62426ec148a02f08c60ae057ed70680a9fea1a0aaa9fef75417756817625724d"
    },
    {
      "herb": "薏苡仁",
      "section": "主治",
      "text": "薏苡仁（Coicis Semen）主治：水肿，脚气，小便不利，脾虚泄泻，湿痹拘挛，肺痈，肠痈，赘疣，癌肿。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "44a7d922911d8a86d633238043b2af9e9e5cb2d683242b3deef8016c680c6091"
    },
    {
      "herb": "薏苡仁",
      "section": "用量",
      "text": "薏苡仁（Coicis Semen）用法用量：9～30g。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "1845104500440ec7ccd3c69755e35ba40993285e82fd36f3c6ae483225c51ad2"
    },
    {
      "herb": "薏苡仁",
      "section": "毒性",
      "text": "薏苡仁（Coicis Semen）毒性：无毒。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "70190b4e6f1ad1f6bf672a040432183b236f31ac4330ba14d155c6f69c453d81"
    },
    {
      "herb": "薏苡仁",
      "section": "禁忌",
      "text": "薏苡仁（Coicis Semen）用药禁忌：孕妇慎用。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "4f88b7f772685e1cdd7a814574ed37dac02bcdc56cf753042d50157140917e07"
    },
    {
      "herb": "薏苡仁",
      "section": "性状",
      "text": "薏苡仁（Coicis Semen）性状：呈宽卵形或长椭圆形，长 4～8mm，宽 3～6mm。表面乳白色，光滑，偶有残存的黄褐色种皮。一端钝圆，另端较宽而微凹，有一淡棕色点状种脐。背面圆凸，腹面有 1 条较宽而深的纵沟。质坚实，断面白色，粉性。气微，味微甜。",
      "source": "《中国药典》2020 年版一部·薏苡仁【性状】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "5c1ece9479fa56f47fbd47ed5b264539f1f79e0d72e40d5b0da06125c14d0da9"
    },
    {
      "herb": "薏苡仁",
      "section": "炮制",
      "text": "薏苡仁（Coicis Semen）炮制：薏苡仁：除去杂质，筛去灰屑。麸炒薏苡仁：取净薏苡仁，照麸炒法（通则 0213）炒至微黄色。",
      "source": "《中国药典》2020 年版一部·薏苡仁【炮制】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "2e28843d11478a754b2b90fb9456204de85b9c9589ad92bc79252099fb6ce298"
    },
    {
      "herb": "薏苡仁",
      "section": "产地",
      "text": "薏苡仁（Coicis Semen）产地：主产于贵州（道地“贵州薏仁”）、云南、福建（本品为禾本科植物薏苡 Coix lacryma-jobi L. var. ma-yuen（Roman.）Stapf 的干燥成熟种仁）",
      "source": "《中国药典》2020 年版一部·薏苡仁【来源】（A 档）+ 教材（B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "e913ed12fa40c532855ee6ec966863fcbf9a49f360dff375d75cef19dc1344b5"
    },
    {
      "herb": "薏苡仁",
      "section": "鉴别要点",
      "text": "薏苡仁（Coicis Semen）鉴别要点：宽卵形或长椭圆形，表面乳白色光滑，一端钝圆、另端较宽而微凹，腹面有 1 条较宽而深的纵沟，断面白色粉性，味微甜。与芡实区别：芡实类球形、一端黄白色占 1/3、有棕红色内种皮。",
      "source": "《中国药典》2020 年版一部·薏苡仁【性状】归纳 + 中药鉴定学教材（A/B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "334fc9cffdb1ada79b0052e678c5a99f27352d58962e91e49b97704fa5c5be5f"
    },
    {
      "herb": "薏苡仁",
      "section": "相似对比",
      "text": "薏苡仁（Coicis Semen）与「芡实」鉴别（同为白色种仁类饮片，断面粉性，色近易混）：本品（薏苡仁）：宽卵形或长椭圆形，表面乳白色、光滑，腹面有 1 条较宽而深的纵沟，一端淡棕色点状种脐；对比药（芡实）：类球形，有棕红色内种皮、一端黄白色约占全体 1/3、有凹点状种脐痕",
      "source": "中药鉴定学教材/药典对照（A/B 档）",
      "source_edition": "《中国药典》2020 年版一部",
