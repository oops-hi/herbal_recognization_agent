{
  "herb": "麦冬",
  "edition": "《中国药典》2020 年版一部",
  "docs": [
    {
      "herb": "麦冬",
      "section": "性味归经",
      "text": "麦冬（Ophiopogonis Radix）性味甘、微苦，微寒，归心、肺、胃经。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "427b738e92c582ac9e1be6b388e62972c216858ff09204b5853fb6e38d205eac"
    },
    {
      "herb": "麦冬",
      "section": "功效",
      "text": "麦冬（Ophiopogonis Radix）功效：养阴生津，润肺清心。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "0086ee6cb6c69278953fd442e8e1e150acf49479ee0e70b95192c8e22941c9f7"
    },
    {
      "herb": "麦冬",
      "section": "主治",
      "text": "麦冬（Ophiopogonis Radix）主治：肺燥干咳，阴虚痨嗽，喉痹咽痛，津伤口渴，内热消渴，心烦失眠，肠燥便秘。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "a8afc514743a390116ba5fcf1b9f5b035e5a34fcfaa4189e949c66b72faaab8e"
    },
    {
      "herb": "麦冬",
      "section": "用量",
      "text": "麦冬（Ophiopogonis Radix）用法用量：6～12g。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "707abac7f9d64b5d31ce8e684d3b31c358001fc795cc41cac36a2825469935fc"
    },
    {
      "herb": "麦冬",
      "section": "毒性",
      "text": "麦冬（Ophiopogonis Radix）毒性：无毒。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "4ea9314f5125e28820df580dbe65a443202785952e90c02f36c468bad8d2e2ab"
    },
    {
      "herb": "麦冬",
      "section": "禁忌",
      "text": "麦冬（Ophiopogonis Radix）用药禁忌：风寒咳嗽、痰饮湿浊、脾虚便溏者慎用。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "2089e352ddd1abb0a93eee023448910cd19a7b585a07554832043cb41b3d50d6"
    },
    {
      "herb": "麦冬",
      "section": "性状",
      "text": "麦冬（Ophiopogonis Radix）性状：呈纺锤形，两端略尖，长 1.5～3cm，直径 0.3～0.6cm。表面淡黄色或灰黄色，有细纵纹。质柔韧，断面黄白色，半透明，中柱细小。气微香，味甘、微苦。",
      "source": "《中国药典》2020 年版一部·麦冬【性状】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "c04dcac3b09fa15f9e557d97872be4348824280f1ca994ed45cc1873ec9bcf7d"
    },
    {
      "herb": "麦冬",
      "section": "炮制",
      "text": "麦冬（Ophiopogonis Radix）炮制：除去杂质，洗净，润透，轧扁，干燥。",
      "source": "《中国药典》2020 年版一部·麦冬【炮制】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "26c32d8d91dde05d4d685b4696a14ea0b27b81277c7e8b91b1c52ddb55f064d7"
    },
    {
      "herb": "麦冬",
      "section": "产地",
      "text": "麦冬（Ophiopogonis Radix）产地：主产于浙江（道地“浙麦冬”）、四川（三台，川麦冬）、湖北（本品为麦冬 Ophiopogon japonicus（Thunb.）Ker-Gawl. 的干燥块根）",
      "source": "《中国药典》2020 年版一部·麦冬【来源】（A 档）+ 教材（B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "d074cbfec43fe8e34a05b8009ca8bb4e9f97c0514e1b694aae55d691bf6d5ec8"
    },
    {
      "herb": "麦冬",
      "section": "鉴别要点",
      "text": "麦冬（Ophiopogonis Radix）鉴别要点：纺锤形两端略尖，表面淡黄色或灰黄色、有细纵纹，质柔韧，断面黄白色半透明、中柱细小，气微香，味甘微苦。",
      "source": "《中国药典》2020 年版一部·麦冬【性状】归纳（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "0de0452d6d7f50d1ceaa196fbda79a27db8828408e998679549cd7a52c11a4fe"
    }
  ]
}
