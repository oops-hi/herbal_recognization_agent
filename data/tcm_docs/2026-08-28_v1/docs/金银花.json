{
  "herb": "金银花",
  "edition": "《中国药典》2020 年版一部",
  "docs": [
    {
      "herb": "金银花",
      "section": "性味归经",
      "text": "金银花（Lonicerae Japonicae Flos）性味甘，寒，归肺、心、胃经。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "238ed8cf870dc7eabd338f304bdbee4655c26d22ca8a629be02c416f8a187d34"
    },
    {
      "herb": "金银花",
      "section": "功效",
      "text": "金银花（Lonicerae Japonicae Flos）功效：清热解毒，疏散风热。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "a20c709cb73d1742fd3037dfd185ccdbba126311022c067cef7e4c353a72dd2b"
    },
    {
      "herb": "金银花",
      "section": "主治",
      "text": "金银花（Lonicerae Japonicae Flos）主治：痈肿疔疮，喉痹，丹毒，热毒血痢，风热感冒，温病发热。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "177db62cc52884e4bcd32335d6967a9800b64174e61aa7525fbbbb605189e0a3"
    },
    {
      "herb": "金银花",
      "section": "用量",
      "text": "金银花（Lonicerae Japonicae Flos）用法用量：6～15g。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "612f0abd713be921dc7a89e33a3be61daf5876729ebf732aed3988a45d1388d0"
    },
    {
      "herb": "金银花",
      "section": "毒性",
      "text": "金银花（Lonicerae Japonicae Flos）毒性：无毒。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "8403190f517f140a6ede95c6284947354bf8fedb803398ceef749736ce7b0525"
    },
    {
      "herb": "金银花",
      "section": "禁忌",
      "text": "金银花（Lonicerae Japonicae Flos）用药禁忌：脾胃虚寒及气虚疮疡脓清者不宜使用。",
      "source": "《中国药典》2020 年版一部",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "169a7db8102f106c078311d506a1703f5b60e5e9febed4b86fb90b5b78be1287"
    },
    {
      "herb": "金银花",
      "section": "性状",
      "text": "金银花（Lonicerae Japonicae Flos）性状：呈棒状，上粗下细，略弯曲，长 2～3cm，上部直径约 3mm，下部直径约 1.5mm。表面黄白色或绿白色（贮久色渐深），密被短柔毛。偶见叶状苞片。花萼绿色，先端 5 裂，裂片有毛，长约 2mm。开放者花冠筒状，先端二唇形；雄蕊 5 个，附于筒壁，黄色；雌蕊 1 个，子房无毛。气清香，味淡、微苦。",
      "source": "《中国药典》2020 年版一部·金银花【性状】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "533a39eafecfa60b307723a045e8ebb5fda44a1292c074608865ff15425e5cee"
    },
    {
      "herb": "金银花",
      "section": "炮制",
      "text": "金银花（Lonicerae Japonicae Flos）炮制：除去杂质，筛去灰屑。",
      "source": "《中国药典》2020 年版一部·金银花【炮制】（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "df9ddc88a1da9b68b41bd567cd009c8bd406afa6999cd73fdb45c3d0b3ee1242"
    },
    {
      "herb": "金银花",
      "section": "产地",
      "text": "金银花（Lonicerae Japonicae Flos）产地：主产于河南（新乡，道地）、山东（平邑）、河北（本品为忍冬 Lonicera japonica Thunb. 的干燥花蕾或带初开的花）",
      "source": "《中国药典》2020 年版一部·金银花【来源】（A 档）+ 教材（B 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "306ed8c71341e635dd55bd4ee9a02220e550210afca582703d1a748b507eb581"
    },
    {
      "herb": "金银花",
      "section": "鉴别要点",
      "text": "金银花（Lonicerae Japonicae Flos）鉴别要点：棒状花蕾，上粗下细略弯曲，表面黄白色或绿白色、密被短柔毛，气清香，味淡微苦。",
      "source": "《中国药典》2020 年版一部·金银花【性状】归纳（A 档）",
      "source_edition": "《中国药典》2020 年版一部",
      "hash": "9ca4abd6f72030cff56734f3f80f4b1b0ed268516fb3aa0fa528ce59df81b858"
    }
  ]
}
